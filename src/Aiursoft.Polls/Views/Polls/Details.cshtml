@using Aiursoft.Polls.Entities
@using Aiursoft.WebTools
@model Aiursoft.Polls.Models.PollsViewModels.DetailsViewModel

<div class="row mb-2 mb-xl-3">
    <div class="col-auto d-none d-sm-block">
        <h3>@Localizer["Poll Details:"] <span class="text-muted">@Model.Poll.Title</span></h3>
    </div>
    <div class="col-auto ms-auto text-end mt-n1">
        @if (Model.Poll.State == PollState.Published && Model.Poll.Deadline > DateTime.UtcNow)
        {
            <button type="button" class="btn btn-outline-secondary" onclick="copyToClipboard('@Url.Action("Vote", "Polls", new { id = Model.Poll.Id }, Context.Request.Scheme)')">
                <i class="align-middle" data-lucide="copy"></i> @Localizer["Copy Link"]
            </button>
        }
        @if (Model.Poll.State == PollState.Published && Model.Poll.Deadline > DateTime.UtcNow && !Model.HasSubmitted)
        {
            <a asp-action="Vote" asp-route-id="@Model.Poll.Id" class="btn btn-success">@Localizer["Vote Now"]</a>
        }

        @if (Model.CanManage)
        {
            <a asp-action="Edit" asp-route-id="@Model.Poll.Id" class="btn btn-primary">@Localizer["Edit"]</a>
            @if (Model.Poll.State == PollState.Draft)
            {
                <form asp-action="Publish" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.Poll.Id" />
                    <button type="submit" class="btn btn-warning">@Localizer["Publish"]</button>
                </form>
            }
            @if (Model.Poll.State == PollState.Published)
            {
                <form asp-action="Terminate" method="post" class="d-inline" onsubmit="return confirm('@Localizer["Are you sure you want to terminate this poll?"]');">
                    <input type="hidden" name="id" value="@Model.Poll.Id" />
                    <button type="submit" class="btn btn-danger btn-sm">@Localizer["Terminate"]</button>
                </form>
                <a asp-action="Extend" asp-route-id="@Model.Poll.Id" class="btn btn-outline-primary btn-sm">@Localizer["Extend"]</a>
                <form asp-action="SendReminder" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.Poll.Id" />
                    <button type="submit" class="btn btn-outline-warning btn-sm"><i class="align-middle" data-lucide="bell"></i> @Localizer["Remind"]</button>
                </form>
            }
            <form asp-action="Invalidate" method="post" class="d-inline" onsubmit="return confirm('@Localizer["Are you sure you want to invalidate this poll? This is a soft delete."]');">
                <input type="hidden" name="id" value="@Model.Poll.Id" />
                <button type="submit" class="btn btn-outline-danger btn-sm">@Localizer["Invalidate"]</button>
            </form>
        }

        @if (Model.Poll.State != PollState.Draft)
        {
            <a asp-action="Results" asp-route-id="@Model.Poll.Id" class="btn btn-info">@Localizer["View Results"]</a>
        }
        <a asp-action="Index" class="btn btn-light">@Localizer["Back to list"]</a>
    </div>
</div>

<div class="row">
    <div class="col-md-4 col-xl-4">
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="card-title mb-0">@Localizer["Poll Info"]</h5>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.Poll.Description))
                {
                    <p>@Model.Poll.Description</p>
                    <hr />
                }
                <div><strong>@Localizer["Status:"]</strong>
                    @switch (Model.Poll.State)
                    {
                        case PollState.Draft: <span class="badge bg-secondary">Draft</span> break;
                        case PollState.Published: <span class="badge bg-success">Published</span> break;
                        case PollState.Completed: <span class="badge bg-info">Completed</span> break;
                        case PollState.Terminated: <span class="badge bg-warning">Terminated</span> break;
                        case PollState.Void: <span class="badge bg-danger">Void</span> break;
                    }
                </div>
                <div><strong>@Localizer["Deadline:"]</strong> <span data-utc-time="@Model.Poll.Deadline.ToHtmlDateTime()"></span></div>
                <div><strong>@Localizer["Created By:"]</strong> @(Model.Poll.CreatedBy?.DisplayName ?? "System")</div>
                <div><strong>@Localizer["Access:"]</strong> @Model.Poll.AccessType</div>
                <div><strong>@Localizer["Result Visibility:"]</strong> @Model.Poll.Visibility</div>
                @if (Model.CanManage && Model.Poll.AccessType != AccessType.Public)
                {
                    <hr />
                    <div><strong>@Localizer["Eligible Voters:"]</strong> @Model.EligibleVotersCount</div>
                    <div><strong>@Localizer["Pending Voters:"]</strong> <span class="text-danger">@Model.PendingVotersCount</span></div>
                    <div class="mt-2">
                        <a asp-action="ExportPendingUsers" asp-route-id="@Model.Poll.Id" class="btn btn-outline-success btn-sm w-100">
                            <i class="align-middle" data-lucide="download"></i> @Localizer["Export Pending Users"]
                        </a>
                    </div>
                }
            </div>
        </div>

        @if (Model.HasSubmitted && Model.UserSubmission != null)
        {
            <div class="card mb-3 border-success">
                <div class="card-header bg-success text-white">
                    <h5 class="card-title mb-0 text-white"><i class="align-middle me-2" data-lucide="check-circle"></i> @Localizer["You Voted"]</h5>
                </div>
                <div class="card-body">
                    <p class="mb-2">@Localizer["Thanks for participating! You submitted your response."]</p>
                    <ul class="list-unstyled mb-0">
                        @foreach (var answer in Model.UserSubmission.Answers ?? [])
                        {
                            <li>- <strong>@answer.Question?.Title</strong>: @(answer.Option?.Content ?? answer.CustomText)</li>
                        }
                    </ul>
                </div>
            </div>
        }

        @if (Model.CanManage && Model.Poll.OperationLogs != null && Model.Poll.OperationLogs.Any())
        {
            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="card-title mb-0">@Localizer["Operation Log"]</h5>
                </div>
                <div class="list-group list-group-flush" style="max-height: 300px; overflow-y: auto;">
                    @foreach (var log in Model.Poll.OperationLogs.OrderByDescending(l => l.Timestamp))
                    {
                        <div class="list-group-item small">
                            <strong>@log.Action</strong>
                            <div class="text-muted">@log.Details</div>
                            <div class="text-muted"><span data-utc-time="@log.Timestamp.ToHtmlDateTime()"></span></div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="col-md-8 col-xl-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">@Localizer["Questions"]</h5>
                @if (Model.CanManage && Model.Poll.State == PollState.Draft)
                {
                    <a asp-action="AddQuestion" asp-route-id="@Model.Poll.Id" class="btn btn-sm btn-outline-primary">
                        <i class="align-middle" data-lucide="plus"></i> @Localizer["Add Question"]
                    </a>
                }
            </div>
            <div class="list-group list-group-flush">
                @if (Model.Poll.Questions != null && Model.Poll.Questions.Any())
                {
                    @foreach (var q in Model.Poll.Questions.OrderBy(x => x.Order))
                    {
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong>Q: @q.Title @(q.IsRequired ? "*" : "")</strong>
                                <div>
                                    <span class="badge bg-secondary me-2">
                                        @if (q.Type == QuestionType.SingleChoice) { @:Single Choice
                                        } else if (q.Type == QuestionType.MultipleChoice) { @:Multiple Choice
                                        }
                                    </span>
                                    @if (Model.CanManage && Model.Poll.State == PollState.Draft)
                                    {
                                        <a asp-action="EditQuestion" asp-route-id="@q.Id" class="btn btn-sm btn-outline-primary me-1">
                                            @Localizer["Edit"]
                                        </a>
                                        <form asp-action="DeleteQuestion" method="post" class="d-inline ms-1" onsubmit="return confirm('@Localizer["Are you sure you want to delete this question?"]');">
                                            <input type="hidden" name="id" value="@q.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="align-middle" data-lucide="trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>

                            @if (q.Options != null && q.Options.Any())
                            {
                                <ul class="list-group mt-2">
                                    @foreach (var opt in q.Options.OrderBy(o => o.DisplayOrder))
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            @opt.Content
                                            @if (opt.AllowCustomText)
                                            {
                                                <span class="badge bg-info">@Localizer["Other"]</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="text-muted small mt-2 mb-0">@Localizer["No options added yet."]</p>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="list-group-item text-center p-4">
                        <p class="text-muted mb-0">@Localizer["No questions have been added to this poll yet."]</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    function copyToClipboard(text) {
        navigator.clipboard.writeText(text).then(function() {
            alert('Link copied to clipboard!');
        }, function(err) {
            console.error('Could not copy text: ', err);
        });
    }
</script>
