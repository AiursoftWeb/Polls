@model Aiursoft.Polls.Models.PollsViewModels.DeleteViewModel

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Details" asp-route-id="@Model.Poll.Id" class="text-decoration-none text-muted small mb-2 d-inline-block">
            ← @Localizer["Back to Poll"]
        </a>
        <h4 class="mb-0">🗑️ @Localizer["Delete Poll"]</h4>
    </div>
</div>

<div class="card border-danger">
    <div class="card-body">
        <h5>⚠️ @Localizer["Are you sure you want to delete this poll?"]</h5>
        <p class="mb-1"><strong>📝 @Localizer["Title:"]</strong> @Model.Poll.Title</p>
        <p class="text-muted">@Localizer["This will soft-delete the poll and mark it as void."]</p>
        <form asp-action="Delete" method="post" class="mt-3">
            <input type="hidden" name="id" value="@Model.Poll.Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">🗑️ @Localizer["Delete"]</button>
                <a asp-action="Details" asp-route-id="@Model.Poll.Id" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
            </div>
        </form>
    </div>
</div>
