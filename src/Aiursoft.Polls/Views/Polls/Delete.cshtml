@model Aiursoft.Polls.Models.PollsViewModels.DeleteViewModel

<div class="row mb-2 mb-xl-3">
    <div class="col-auto d-none d-sm-block">
        <h3>@Localizer["Delete Poll"]</h3>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h5>@Localizer["Are you sure you want to delete this poll?"]</h5>
        <p class="mb-1"><strong>@Localizer["Title:"]</strong> @Model.Poll.Title</p>
        <p class="text-muted">@Localizer["This will soft-delete the poll and mark it as void."]</p>
        <form asp-action="Delete" method="post">
            <input type="hidden" name="id" value="@Model.Poll.Id" />
            <button type="submit" class="btn btn-danger">@Localizer["Delete"]</button>
            <a asp-action="Details" asp-route-id="@Model.Poll.Id" class="btn btn-light">@Localizer["Cancel"]</a>
        </form>
    </div>
</div>
