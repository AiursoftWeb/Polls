@using Aiursoft.Polls.Entities
@using Aiursoft.WebTools
@model Aiursoft.Polls.Models.PollsViewModels.DetailsViewModel

<div class="poll-detail-header mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
        <div class="poll-title-section">
            <h2 class="mb-1 fw-bold">@Localizer["Poll Details"]</h2>
            <p class="text-muted mb-0 fs-5">@Model.Poll.Title</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            @switch (Model.Poll.State)
            {
                case PollState.Draft: <span class="status-badge status-draft">Draft</span> break;
                case PollState.Published: <span class="status-badge status-published">Published</span> break;
                case PollState.Completed: <span class="status-badge status-completed">Completed</span> break;
                case PollState.Terminated: <span class="status-badge status-terminated">Terminated</span> break;
                case PollState.Void: <span class="status-badge status-void">Void</span> break;
            }
        </div>
    </div>

    <div class="action-toolbar">
        @* ---- Primary Actions ---- *@
        <div class="toolbar-group">
            @if (Model.Poll.State == PollState.Published && Model.Poll.Deadline > DateTime.UtcNow && !Model.HasSubmitted)
            {
                <a asp-action="Vote" asp-route-id="@Model.Poll.Id" class="toolbar-btn toolbar-btn-solid toolbar-btn-vote">
                    <i class="align-middle" data-lucide="vote"></i> <span>@Localizer["Vote Now"]</span>
                </a>
            }
            @if (Model.CanManage)
            {
                <a asp-action="Edit" asp-route-id="@Model.Poll.Id" class="toolbar-btn toolbar-btn-solid toolbar-btn-edit">
                    <i class="align-middle" data-lucide="pencil"></i> <span>@Localizer["Edit"]</span>
                </a>
                @if (Model.Poll.State == PollState.Draft)
                {
                    <form asp-action="Publish" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@Model.Poll.Id" />
                        <button type="submit" class="toolbar-btn toolbar-btn-solid toolbar-btn-publish">
                            <i class="align-middle" data-lucide="send"></i> <span>@Localizer["Publish"]</span>
                        </button>
                    </form>
                }
            }
            @if (Model.Poll.State != PollState.Draft)
            {
                <a asp-action="Results" asp-route-id="@Model.Poll.Id" class="toolbar-btn toolbar-btn-outline toolbar-btn-results">
                    <i class="align-middle" data-lucide="bar-chart-2"></i> <span>@Localizer["View Results"]</span>
                </a>
            }
        </div>

        @* ---- Utility Actions ---- *@
        @if ((Model.Poll.State == PollState.Published && Model.Poll.Deadline > DateTime.UtcNow) || (Model.CanManage && Model.Poll.State == PollState.Published))
        {
            <span class="toolbar-separator"></span>
            <div class="toolbar-group">
                @if (Model.Poll.State == PollState.Published && Model.Poll.Deadline > DateTime.UtcNow)
                {
                    <button type="button" class="toolbar-btn toolbar-btn-ghost" onclick="copyToClipboard('@Url.Action("Vote", "Polls", new { id = Model.Poll.Id }, Context.Request.Scheme)')">
                        <i class="align-middle" data-lucide="copy"></i> <span>@Localizer["Copy Link"]</span>
                    </button>
                }
                @if (Model.CanManage && Model.Poll.State == PollState.Published)
                {
                    <a asp-action="Extend" asp-route-id="@Model.Poll.Id" class="toolbar-btn toolbar-btn-ghost">
                        <i class="align-middle" data-lucide="clock"></i> <span>@Localizer["Extend"]</span>
                    </a>
                    @if (Model.Poll.AccessType == AccessType.RoleBased)
                    {
                        <form asp-action="SendReminder" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@Model.Poll.Id" />
                            <button type="submit" class="toolbar-btn toolbar-btn-ghost">
                                <i class="align-middle" data-lucide="bell"></i> <span>@Localizer["Remind"]</span>
                            </button>
                        </form>
                    }
                }
            </div>
        }

        @* ---- Destructive Actions ---- *@
        @if (Model.CanManage)
        {
            <span class="toolbar-separator"></span>
            <div class="toolbar-group">
                @if (Model.Poll.State == PollState.Published)
                {
                    <form asp-action="Terminate" method="post" class="d-inline" onsubmit="return confirmAction(event, '@Localizer["Are you sure you want to terminate this poll?"]')">
                        <input type="hidden" name="id" value="@Model.Poll.Id" />
                        <button type="submit" class="toolbar-btn toolbar-btn-ghost toolbar-btn-terminate">
                            <i class="align-middle" data-lucide="stop-circle"></i> <span>@Localizer["Terminate"]</span>
                        </button>
                    </form>
                }
                <form asp-action="Invalidate" method="post" class="d-inline" onsubmit="return confirmAction(event, '@Localizer["Are you sure you want to delete this poll? This is a soft delete."]')">
                    <input type="hidden" name="id" value="@Model.Poll.Id" />
                    <button type="submit" class="toolbar-btn toolbar-btn-ghost toolbar-btn-delete">
                        <i class="align-middle" data-lucide="trash-2"></i> <span>@Localizer["Delete"]</span>
                    </button>
                </form>
            </div>
        }

        @* ---- Navigation ---- *@
        <span class="toolbar-separator ms-auto"></span>
        <div class="toolbar-group">
            <a asp-action="Index" class="toolbar-btn toolbar-btn-ghost">
                <i class="align-middle" data-lucide="arrow-left"></i> <span>@Localizer["Back to list"]</span>
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4 col-xl-4">
        <div class="card card-enhanced mb-3">
            <div class="card-header-enhanced">
                <i class="align-middle me-2" data-lucide="info"></i> @Localizer["Poll Info"]
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.Poll.Description))
                {
                    <p class="text-secondary">@Model.Poll.Description</p>
                    <hr class="my-3" />
                }
                <dl class="info-list">
                    <dt>@Localizer["Status"]</dt>
                    <dd>
                        @switch (Model.Poll.State)
                        {
                            case PollState.Draft: <span class="badge rounded-pill bg-secondary">Draft</span> break;
                            case PollState.Published: <span class="badge rounded-pill bg-success">Published</span> break;
                            case PollState.Completed: <span class="badge rounded-pill bg-info">Completed</span> break;
                            case PollState.Terminated: <span class="badge rounded-pill bg-warning text-dark">Terminated</span> break;
                            case PollState.Void: <span class="badge rounded-pill bg-danger">Void</span> break;
                        }
                    </dd>
                    <dt>@Localizer["Deadline"]</dt>
                    <dd><span data-utc-time="@Model.Poll.Deadline.ToHtmlDateTime()"></span></dd>
                    <dt>@Localizer["Created By"]</dt>
                    <dd>@(Model.Poll.CreatedBy?.DisplayName ?? "System")</dd>
                    <dt>@Localizer["Access"]</dt>
                    <dd>
                        @switch (Model.Poll.AccessType)
                        {
                            case AccessType.Public: <span class="badge rounded-pill bg-success">Public</span> break;
                            case AccessType.RegisteredOnly: <span class="badge rounded-pill bg-primary">Registered</span> break;
                            case AccessType.RoleBased: <span class="badge rounded-pill bg-info">Role-Based</span> break;
                        }
                    </dd>
                    <dt>@Localizer["Result Visibility"]</dt>
                    <dd>@Model.Poll.Visibility</dd>
                    <dt>@Localizer["Anonymous"]</dt>
                    <dd>@(Model.Poll.IsAnonymous ? Localizer["Yes"] : Localizer["No"])</dd>
                </dl>
                @if (Model.Poll.IsAnonymous)
                {
                    <div class="alert alert-info py-2 px-3 mt-3 mb-0 small d-flex align-items-center gap-2">
                        <i class="flex-shrink-0" data-lucide="shield-check"></i>
                        <span>@Localizer["Anonymous: Identity and IP will NOT be recorded."]</span>
                    </div>
                }
                @if (Model.CanManage && Model.Poll.AccessType == AccessType.RoleBased && !Model.Poll.IsAnonymous)
                {
                    <hr class="my-3" />
                    <dl class="info-list">
                        <dt>@Localizer["Eligible Voters"]</dt>
                        <dd>@Model.EligibleVotersCount</dd>
                        <dt>@Localizer["Pending Voters"]</dt>
                        <dd><span class="text-danger fw-semibold">@Model.PendingVotersCount</span></dd>
                    </dl>
                }
                @if (Model.CanManage && Model.Poll.AccessType == AccessType.RoleBased)
                {
                    <div class="d-grid gap-2 mt-3">
                        <a asp-action="VoterStatus" asp-route-id="@Model.Poll.Id" class="btn btn-outline-secondary btn-sm @(Model.Poll.IsAnonymous ? "disabled" : "")">
                            <i class="align-middle me-1" data-lucide="users"></i> @Localizer["View Voter Status"]
                        </a>
                        <a asp-action="Submissions" asp-route-id="@Model.Poll.Id" class="btn btn-outline-secondary btn-sm">
                            <i class="align-middle me-1" data-lucide="list"></i> @Localizer["View Submissions"]
                        </a>
                        <a asp-action="ExportPendingUsers" asp-route-id="@Model.Poll.Id" class="btn btn-outline-secondary btn-sm @(Model.Poll.IsAnonymous ? "disabled" : "")">
                            <i class="align-middle me-1" data-lucide="download"></i> @Localizer["Export Pending Users"]
                        </a>
                    </div>
                }
            </div>
        </div>

        @if (Model.HasSubmitted && Model.UserSubmission != null && Model.Poll.IsAnonymous == false)
        {
            <div class="card card-enhanced card-voted mb-3">
                <div class="card-header-voted">
                    <i class="align-middle me-2" data-lucide="check-circle"></i> @Localizer["You Voted"]
                </div>
                <div class="card-body">
                    <p class="mb-3">@Localizer["Thanks for participating! You submitted your response."]</p>
                    <ul class="list-unstyled mb-0 submission-list">
                        @foreach (var answer in Model.UserSubmission.Answers ?? [])
                        {
                            <li class="d-flex gap-2 mb-2">
                                <i class="align-middle text-success flex-shrink-0 mt-1" data-lucide="check"></i>
                                <span><strong>@answer.Question?.Title</strong>: @(answer.Option?.Content ?? answer.CustomText)</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }

        @if (Model.CanManage && Model.Poll.OperationLogs != null && Model.Poll.OperationLogs.Any())
        {
            <div class="card card-enhanced mb-3">
                <div class="card-header-enhanced">
                    <i class="align-middle me-2" data-lucide="history"></i> @Localizer["Operation Log"]
                </div>
                <div class="list-group list-group-flush log-scroll">
                    @foreach (var log in Model.Poll.OperationLogs.OrderByDescending(l => l.Timestamp))
                    {
                        <div class="list-group-item border-0 border-bottom py-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <strong class="small">@log.Action</strong>
                                <small class="text-muted"><span data-utc-time="@log.Timestamp.ToHtmlDateTime()"></span></small>
                            </div>
                            <div class="text-muted small">@log.Details</div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="col-md-8 col-xl-8">
        <div class="card card-enhanced">
            <div class="card-header-enhanced d-flex justify-content-between align-items-center">
                <span><i class="align-middle me-2" data-lucide="list-checks"></i> @Localizer["Questions"]</span>
                @if (Model.CanManage && Model.Poll.State == PollState.Draft)
                {
                    <a asp-action="AddQuestion" asp-route-id="@Model.Poll.Id" class="btn btn-primary btn-sm rounded-pill px-3">
                        <i class="align-middle me-1" data-lucide="plus"></i> @Localizer["Add Question"]
                    </a>
                }
            </div>
            <div class="list-group list-group-flush">
                @if (Model.Poll.Questions != null && Model.Poll.Questions.Any())
                {
                    var questions = Model.Poll.Questions.OrderBy(x => x.Order).ToList();
                    for (var i = 0; i < questions.Count; i++)
                    {
                        var q = questions[i];
                        var index = i;
                        var isLast = i == questions.Count - 1;
                        <div class="list-group-item border-0 @(isLast ? "" : "border-bottom") py-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <strong class="me-2">@Localizer["Q:"] @q.Title</strong>
                                    @if (q.IsRequired)
                                    {
                                        <span class="text-danger">*</span>
                                    }
                                </div>
                                <div class="d-flex align-items-center gap-1 flex-shrink-0 ms-2">
                                    <span class="badge question-type-badge me-2">
                                        @if (q.Type == QuestionType.SingleChoice) { @:Single Choice
                                        } else if (q.Type == QuestionType.MultipleChoice) { @:Multiple Choice
                                        }
                                    </span>
                                    @if (Model.CanManage && Model.Poll.State == PollState.Draft)
                                    {
                                        <form asp-action="MoveQuestionUp" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@q.Id" />
                                            <button type="submit" class="btn btn-sm btn-icon" @(index == 0 ? "disabled" : "") title="@Localizer["Move Up"]">
                                                <i class="align-middle" data-lucide="chevron-up"></i>
                                            </button>
                                        </form>
                                        <form asp-action="MoveQuestionDown" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@q.Id" />
                                            <button type="submit" class="btn btn-sm btn-icon" @(isLast ? "disabled" : "") title="@Localizer["Move Down"]">
                                                <i class="align-middle" data-lucide="chevron-down"></i>
                                            </button>
                                        </form>
                                        <a asp-action="EditQuestion" asp-route-id="@q.Id" class="btn btn-sm btn-icon" title="@Localizer["Edit"]">
                                            <i class="align-middle" data-lucide="pencil"></i>
                                        </a>
                                        <form asp-action="DeleteQuestion" method="post" class="d-inline" onsubmit="return confirmAction(event, '@Localizer["Are you sure you want to delete this question?"]')">
                                            <input type="hidden" name="id" value="@q.Id" />
                                            <button type="submit" class="btn btn-sm btn-icon btn-icon-danger" title="@Localizer["Delete"]">
                                                <i class="align-middle" data-lucide="trash-2"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>

                            @if (q.Options != null && q.Options.Any())
                            {
                                <ul class="list-group mt-2 option-list">
                                    @foreach (var opt in q.Options.OrderBy(o => o.DisplayOrder))
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center border-0 py-2 px-3">
                                            <span>@opt.Content</span>
                                            @if (opt.AllowCustomText)
                                            {
                                                <span class="badge rounded-pill bg-light text-dark border">@Localizer["Other"]</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="text-muted small mt-2 mb-0 ps-2">@Localizer["No options added yet."]</p>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="list-group-item border-0 text-center py-5">
                        <i class="align-middle d-block mb-3 text-muted opacity-25" data-lucide="help-circle" style="width: 48px; height: 48px; margin: 0 auto;"></i>
                        <p class="text-muted mb-0">@Localizer["No questions have been added to this poll yet."]</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(function() {
                Swal.fire({
                    title: '@Localizer["Copied!"]',
                    text: '@Localizer["Link copied to clipboard!"]',
                    icon: 'success',
                    timer: 2000,
                    showConfirmButton: false
                });
            }, function(err) {
                console.error('Could not copy text: ', err);
            });
        }

        function confirmAction(event, message) {
            event.preventDefault();
            const form = event.currentTarget;
            Swal.fire({
                title: '@Localizer["Confirm Action"]',
                text: message,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: '@Localizer["Yes"]',
                cancelButtonText: '@Localizer["Cancel"]'
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
            return false;
        }
    </script>
}
