@using Aiursoft.Polls.Entities
@model Aiursoft.Polls.Models.PollsViewModels.VoteViewModel

@{
    var questions = Model.Poll?.Questions?.OrderBy(x => x.Order).ToList() ?? [];
    var totalSteps = questions.Count;
}

<style>
    .voting-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 20px;
    }

    .question-step {
        display: none;
    }

    .question-step.active {
        display: block;
        animation: fadeIn 0.3s ease-in-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .option-card {
        border: 1px solid rgba(0,0,0,.125);
        border-radius: 0.5rem;
        padding: 1rem;
        margin-bottom: 0.75rem;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        background-color: var(--bs-card-bg);
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .option-card:hover {
        background-color: rgba(0,0,0,.03);
        transform: translateY(-2px);
        box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,.075);
    }

    .option-card.selected {
        border-color: var(--bs-primary);
        background-color: rgba(var(--bs-primary-rgb), 0.05);
    }

    .option-card .selection-indicator {
        width: 20px;
        height: 20px;
        border: 2px solid #dee2e6;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .option-card.selected .selection-indicator {
        border-color: var(--bs-primary);
        background-color: var(--bs-primary);
    }

    .option-card.selected .selection-indicator::after {
        content: '';
        width: 8px;
        height: 8px;
        background-color: white;
        border-radius: 50%;
    }

    .question-title {
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .question-subtitle {
        color: var(--bs-secondary-color);
        margin-bottom: 1.5rem;
    }

    .custom-text-container {
        display: none;
        margin-top: -0.5rem;
        margin-bottom: 1rem;
        padding-left: 3rem;
    }
</style>

<div class="voting-container">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-action="Index" class="btn btn-link p-0 text-secondary" title="@Localizer["Cancel"]">
            <i class="align-middle" data-lucide="x"></i>
        </a>
        <div class="progress flex-grow-1" style="height: 8px;">
            <div id="progressFill" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%"></div>
        </div>
    </div>

    <div class="mb-4">
        <h3>@Model.Poll?.Title</h3>
        @if (!string.IsNullOrWhiteSpace(Model.Poll?.Description))
        {
            <p class="text-muted">@Model.Poll.Description</p>
        }
    </div>

    <form asp-action="Vote" method="post" id="voteForm">
        <input type="hidden" asp-for="PollId" />
        <input type="hidden" asp-for="BrowserFingerprint" id="browserFingerprint" />

        @for (int i = 0; i < questions.Count; i++)
        {
            var q = questions[i];
            <div class="question-step @(i == 0 ? "active" : "")" data-step="@i" data-required="@q.IsRequired.ToString().ToLower()" data-type="@q.Type">
                <div class="d-flex align-items-center mb-1">
                    <h4 class="question-title mb-0">@q.Title</h4>
                    @if (q.Type == QuestionType.SingleChoice)
                    {
                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle fw-normal ms-2">@Localizer["Single Choice"]</span>
                    }
                    else
                    {
                        <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle fw-normal ms-2">@Localizer["Multiple Choice"]</span>
                    }
                </div>
                <p class="question-subtitle">
                    @switch (q.Type)
                    {
                        case QuestionType.SingleChoice: @Localizer["Select the best option"] break;
                        case QuestionType.MultipleChoice: @Localizer["Select all that apply"] break;
                    }
                    @if (q.IsRequired) { <span class="text-danger">*</span> }
                </p>
                
                <div class="options-list">
                    @if (q.Options != null)
                    {
                        foreach (var opt in q.Options.OrderBy(o => o.DisplayOrder))
                        {
                            <div class="option-card" data-opt-id="@opt.Id" data-question-id="@q.Id" data-has-custom="@opt.AllowCustomText.ToString().ToLower()">
                                <div class="selection-indicator"></div>
                                <div class="option-content">@opt.Content</div>
                            </div>
                            
                            if (opt.AllowCustomText)
                            {
                                <div class="custom-text-container" id="custom_text_container_@opt.Id">
                                    <input type="text" 
                                           class="form-control" 
                                           name="CustomTexts[@q.Id]" 
                                           placeholder="@Localizer["Please specify..."]" 
                                           data-opt-id="@opt.Id" />
                                </div>
                            }
                        }
                    }
                </div>
                
                @if (q.Type == QuestionType.MultipleChoice)
                {
                    <input type="hidden" name="SelectedOptions[@q.Id]" id="multiInput_@q.Id" value="" />
                }
                else
                {
                    <input type="hidden" name="SelectedOptions[@q.Id]" id="singleInput_@q.Id" value="" />
                }
            </div>
        }
    </form>

    <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top">
        <button id="prevBtn" class="btn btn-outline-secondary px-4 d-none">
            <i class="align-middle me-1" data-lucide="chevron-left"></i> @Localizer["Back"]
        </button>
        <div class="flex-grow-1"></div>
        <button id="nextBtn" class="btn btn-primary px-5" disabled>
            @Localizer["Continue"] <i class="align-middle ms-1" data-lucide="chevron-right"></i>
        </button>
    </div>
</div>

@section scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Browser fingerprint
            var fp = navigator.userAgent + "|" + screen.width + "x" + screen.height + "|" + new Date().getTimezoneOffset();
            document.getElementById("browserFingerprint").value = btoa(fp).substring(0, 200);

            const totalSteps = @totalSteps;
            let currentStep = 0;
            const steps = document.querySelectorAll('.question-step');
            const progressFill = document.getElementById('progressFill');
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');
            const voteForm = document.getElementById('voteForm');

            function updateUI() {
                // Update Progress
                const progress = ((currentStep) / totalSteps) * 100;
                progressFill.style.width = progress + '%';

                // Show/Hide steps
                steps.forEach((step, idx) => {
                    step.classList.toggle('active', idx === currentStep);
                });

                // Footer Buttons
                if (currentStep === 0) {
                    prevBtn.classList.add('d-none');
                } else {
                    prevBtn.classList.remove('d-none');
                }
                
                if (currentStep === totalSteps - 1) {
                    nextBtn.innerHTML = '@Localizer["Finish"] <i class="align-middle ms-1" data-lucide="check"></i>';
                } else {
                    nextBtn.innerHTML = '@Localizer["Continue"] <i class="align-middle ms-1" data-lucide="chevron-right"></i>';
                }

                validateCurrentStep();
                
                // Re-initialize icons if needed (lucide.replace() is usually called globally, but let's be safe if it's dynamic)
                if (window.lucide) {
                    window.lucide.createIcons();
                }
            }

            function validateCurrentStep() {
                const step = steps[currentStep];
                const isRequired = step.dataset.required === 'true';
                
                let isValid = true;
                if (isRequired) {
                    const selected = step.querySelectorAll('.option-card.selected');
                    if (selected.length === 0) {
                        isValid = false;
                    } else {
                        // Check custom text if needed
                        selected.forEach(card => {
                            if (card.dataset.hasCustom === 'true') {
                                const optId = card.dataset.optId;
                                const input = step.querySelector(`input[data-opt-id="${optId}"]`);
                                if (input && !input.value.trim()) {
                                    isValid = false;
                                }
                            }
                        });
                    }
                }
                
                nextBtn.disabled = !isValid;
            }

            // Handle Option Selection
            document.querySelectorAll('.option-card').forEach(card => {
                card.addEventListener('click', function() {
                    const step = this.closest('.question-step');
                    const type = step.dataset.type;
                    const questionId = this.dataset.questionId;
                    const optId = this.dataset.optId;
                    const hasCustom = this.dataset.hasCustom === 'true';

                    if (type === 'SingleChoice') {
                        step.querySelectorAll('.option-card').forEach(c => {
                            c.classList.remove('selected');
                            // Hide other custom texts
                            const otherOptId = c.dataset.optId;
                            const otherCustom = document.getElementById('custom_text_container_' + otherOptId);
                            if (otherCustom) otherCustom.style.display = 'none';
                        });
                        this.classList.add('selected');
                        document.getElementById('singleInput_' + questionId).value = optId;
                        
                        if (hasCustom) {
                            document.getElementById('custom_text_container_' + optId).style.display = 'block';
                            document.getElementById('custom_text_container_' + optId).querySelector('input').focus();
                        }
                    } else {
                        // Multiple Choice
                        this.classList.toggle('selected');
                        const selectedOpts = Array.from(step.querySelectorAll('.option-card.selected')).map(c => c.dataset.optId);
                        document.getElementById('multiInput_' + questionId).value = selectedOpts.join(',');
                        
                        if (hasCustom) {
                            const customContainer = document.getElementById('custom_text_container_' + optId);
                            customContainer.style.display = this.classList.contains('selected') ? 'block' : 'none';
                            if (this.classList.contains('selected')) {
                                customContainer.querySelector('input').focus();
                            }
                        }
                    }

                    validateCurrentStep();
                });
            });

            // Handle Custom Text Input
            document.querySelectorAll('.custom-text-container input').forEach(input => {
                input.addEventListener('input', validateCurrentStep);
                input.addEventListener('click', e => e.stopPropagation());
            });

            nextBtn.addEventListener('click', function() {
                if (currentStep < totalSteps - 1) {
                    currentStep++;
                    updateUI();
                    window.scrollTo(0, 0);
                } else {
                    // Final Submit
                    nextBtn.disabled = true;
                    nextBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> @Localizer["Submitting..."]';
                    progressFill.style.width = '100%';
                    voteForm.submit();
                }
            });

            prevBtn.addEventListener('click', function() {
                if (currentStep > 0) {
                    currentStep--;
                    updateUI();
                    window.scrollTo(0, 0);
                }
            });

            // Initial UI state
            updateUI();
        });
    </script>
}
