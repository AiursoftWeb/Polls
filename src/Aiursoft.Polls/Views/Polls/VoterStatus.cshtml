@using Aiursoft.Polls.Models.PollsViewModels
@using Aiursoft.Polls.Services.FileStorage
@using Aiursoft.WebTools
@inject IViewLocalizer Localizer
@inject StorageService StorageService
@model VoterStatusViewModel

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Details" asp-route-id="@Model.Poll?.Id" class="text-decoration-none text-muted small mb-2 d-inline-block">
            ← @Localizer["Back to Poll"]
        </a>
        <h4 class="mb-0">👥 <strong>@Localizer["Voter Status"]</strong> — @Model.Poll?.Title</h4>
    </div>
</div>

    <div class="row">
        <div class="col-12">
            @if (Model.Poll?.IsAnonymous == true)
            {
                <div class="alert alert-warning">
                    <i class="align-middle me-2" data-lucide="alert-triangle"></i>
                    <strong>@Localizer["Anonymous Poll Notice:"]</strong> @Localizer["This poll is anonymous. The system does not record which user submitted which response. Therefore, all users will appear as 'Pending' in this list, and 'Voter Status' cannot be tracked."]
                </div>
            }
            <div class="card">
                <div class="card-body">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>@Localizer["User"]</th>
                                <th>@Localizer["Email"]</th>
                                <th>@Localizer["Status"]</th>
                                <th>@Localizer["Submit Time"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var userStatus in Model.Users.OrderBy(u => u.HasVoted).ThenBy(u => u.User?.DisplayName))
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@StorageService.RelativePathToInternetUrl(userStatus.User?.AvatarRelativePath ?? Aiursoft.Polls.Entities.User.DefaultAvatarPath)?w=72&square=true" alt="@userStatus.User?.DisplayName" class="rounded-circle me-2" width="32" height="32">
                                            <span>@userStatus.User?.DisplayName</span>
                                        </div>
                                    </td>
                                    <td>@userStatus.User?.Email</td>
                                    <td>
                                        @if (userStatus.HasVoted)
                                        {
                                            <span class="badge bg-success">@Localizer["Voted"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@Localizer["Pending"]</span>
                                        }
                                    </td>
                                    <td>
                                        @if (userStatus.VoteTime.HasValue)
                                        {
                                            <span data-utc-time="@userStatus.VoteTime.Value.ToHtmlDateTime()"></span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
