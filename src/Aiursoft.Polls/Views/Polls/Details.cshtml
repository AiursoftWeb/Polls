@using Aiursoft.Polls.Entities
@using Aiursoft.WebTools
@model Aiursoft.Polls.Models.PollsViewModels.DetailsViewModel

@{
    var isActive = Model.Poll.State == PollState.Published && Model.Poll.Deadline > DateTime.UtcNow;
    var isDraft = Model.Poll.State == PollState.Draft;
    var canReopen = Model.Poll.State is PollState.Completed or PollState.Terminated;
    var questions = Model.Poll.Questions?.OrderBy(x => x.Order).ToList() ?? [];
    var stateClass = Model.Poll.State switch
    {
        PollState.Draft => "secondary",
        PollState.Published => "success",
        PollState.Completed => "info",
        PollState.Terminated => "warning",
        PollState.Void => "danger",
        _ => "secondary"
    };
    var stateIcon = Model.Poll.State switch
    {
        PollState.Draft => "file-pen-line",
        PollState.Published => "radio",
        PollState.Completed => "circle-check-big",
        PollState.Terminated => "circle-stop",
        PollState.Void => "ban",
        _ => "circle"
    };
    var stateTitle = Model.Poll.State switch
    {
        PollState.Draft => Localizer["Draft exam"],
        PollState.Published => Localizer["Exam is open"],
        PollState.Completed => Localizer["Exam completed"],
        PollState.Terminated => Localizer["Exam terminated"],
        PollState.Void => Localizer["Exam voided"],
        _ => Localizer[Model.Poll.State.ToString()]
    };
    var accessText = Model.Poll.AccessType switch
    {
        AccessType.Public => Localizer["Public"],
        AccessType.RegisteredOnly => Localizer["Registered employees"],
        AccessType.RoleBased => Localizer["Selected roles"],
        AccessType.Assigned => Localizer["Assigned employees and roles"],
        _ => Localizer[Model.Poll.AccessType.ToString()]
    };
}

@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/styles/exam.css" asp-append-version="true" />
}

<div class="exam-ui">
    <div class="exam-page-header">
        <div>
            <a asp-action="Index" class="exam-back-link"><i data-lucide="arrow-left"></i> @Localizer["Back to exams"]</a>
            <div class="exam-kicker"><i data-lucide="clipboard-check"></i> @Localizer["Exam overview"]</div>
            <h1 class="h3">@Model.Poll.Title</h1>
        </div>
        <div class="exam-actions d-flex flex-wrap align-items-center gap-2">
            @if (isActive && (!Model.HasSubmitted || Model.Poll.AllowRepeatedSubmissions))
            {
                <a asp-action="Vote" asp-route-id="@Model.Poll.Id" class="btn btn-success shadow-sm">
                    <i class="align-middle me-1" data-lucide="play"></i>
                    @(Model.HasSubmitted ? Localizer["Take again"] : Localizer["Start exam"])
                </a>
            }
            @if (Model.CanEdit)
            {
                <a asp-action="Edit" asp-route-id="@Model.Poll.Id" class="btn btn-primary">
                    <i class="align-middle me-1" data-lucide="pencil"></i> @Localizer["Edit"]
                </a>
            }
            <div class="dropdown">
                <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="align-middle me-1" data-lucide="ellipsis"></i> @Localizer["More"]
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow">
                    @if (Model.CanManage)
                    {
                        <li><a asp-action="Submissions" asp-route-id="@Model.Poll.Id" class="dropdown-item"><i class="align-middle me-2" data-lucide="bar-chart-3"></i>@Localizer["Employee results"]</a></li>
                    }
                    @if (Model.CanManageShares)
                    {
                        <li><a asp-action="ManageShares" asp-route-id="@Model.Poll.Id" class="dropdown-item"><i class="align-middle me-2" data-lucide="share-2"></i>@Localizer["Collaborators"]</a></li>
                    }
                    @if (isActive)
                    {
                        <li><hr class="dropdown-divider" /></li>
                        <li><button type="button" class="dropdown-item" onclick="copyToClipboard('@Url.Action("Vote", "Polls", new { id = Model.Poll.Id }, Context.Request.Scheme)')"><i class="align-middle me-2" data-lucide="link"></i>@Localizer["Copy participant link"]</button></li>
                    }
                </ul>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-outline-coloured mb-4" role="alert">
            <div class="alert-icon"><i data-lucide="circle-alert"></i></div>
            <div class="alert-message d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div><strong>@Localizer["Unable to publish exam"]</strong><span class="d-block small">@errorMessage</span></div>
                @if (Model.CanEdit)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Poll.Id" class="btn btn-sm btn-outline-danger">@Localizer["Review settings"]</a>
                }
            </div>
        </div>
    }
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-outline-coloured mb-4" role="alert">
            <div class="alert-icon"><i data-lucide="circle-check"></i></div>
            <div class="alert-message"><strong>@Localizer["Exam published"]</strong><span class="d-block small">@successMessage</span></div>
        </div>
    }

    <div class="alert alert-@stateClass alert-outline-coloured mb-4" role="alert">
        <div class="alert-icon"><i data-lucide="@stateIcon"></i></div>
        <div class="alert-message d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div>
                <strong>@stateTitle</strong>
                <span class="d-block small">
                    @if (isDraft)
                    {
                        @Localizer["Add and review questions, then publish when the exam is ready."]
                    }
                    else if (isActive)
                    {
                        @Localizer["Employees can start a new timed attempt until the deadline."]
                    }
                    else
                    {
                        @Localizer["New attempts are not currently available."]
                    }
                </span>
            </div>
            <div class="small text-muted"><i class="align-middle me-1" data-lucide="calendar-clock"></i><span data-utc-time="@Model.Poll.Deadline.ToHtmlDateTime()"></span></div>
        </div>
    </div>

    @if (Model.HasSubmitted && Model.UserSubmission != null && !Model.Poll.IsAnonymous)
    {
        <div class="alert alert-@(Model.UserSubmission.Passed ? "success" : "warning") alert-outline-coloured mb-4" role="alert">
            <div class="alert-icon"><i data-lucide="@(Model.UserSubmission.Passed ? "badge-check" : "chart-no-axes-column-increasing")"></i></div>
            <div class="alert-message d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <strong>@Localizer["Your latest score"]: <span class="exam-score">@Model.UserSubmission.Score / @Model.UserSubmission.MaxScore</span></strong>
                    <span class="d-block small">@Localizer["Attempt"] #@Model.UserSubmission.AttemptNumber · @(Model.UserSubmission.Passed ? Localizer["Passed"] : Localizer["Not passed yet"])</span>
                </div>
                <a asp-action="AttemptResult" asp-route-id="@Model.UserSubmission.Id" class="btn btn-sm btn-outline-@(Model.UserSubmission.Passed ? "success" : "warning")">@Localizer["Review attempt"]</a>
            </div>
        </div>
    }

    <div class="row g-4">
        <div class="col-xl-8">
            <section class="exam-card mb-4">
                <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div>
                        <h2 class="exam-section-title">
                            <span class="section-icon"><i data-lucide="list-checks"></i></span>
                            @Localizer["Questions"]
                        </h2>
                        <p class="exam-subtitle">@questions.Count @Localizer["questions in this exam"] · @Model.Poll.QuestionsPerAttempt @Localizer["sampled per attempt"]</p>
                    </div>
                    @if (Model.CanEdit)
                    {
                        <a asp-action="AddQuestion" asp-route-id="@Model.Poll.Id" class="btn btn-primary btn-sm">
                            <i class="align-middle me-1" data-lucide="plus"></i> @Localizer["Add question"]
                        </a>
                    }
                </div>
                <div class="card-body">
                    @if (questions.Any())
                    {
                        <div class="vstack gap-3">
                            @for (var i = 0; i < questions.Count; i++)
                            {
                                var question = questions[i];
                                var isFirst = i == 0;
                                var isLast = i == questions.Count - 1;
                                var options = question.Options?.OrderBy(o => o.DisplayOrder).ToList() ?? [];
                                <article class="exam-question">
                                    <div class="card-body p-3 p-md-4">
                                        <div class="d-flex align-items-start gap-3">
                                            <div class="exam-question-number">@(i + 1)</div>
                                            <div class="flex-grow-1 min-w-0">
                                                <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
                                                    <div>
                                                        <h3 class="h6 lh-base mb-1">@question.Title @if (question.IsRequired) { <span class="text-danger">*</span> }</h3>
                                                        <div class="text-muted small d-flex align-items-center gap-1">
                                                            <i data-lucide="@(question.Type == QuestionType.SingleChoice ? "circle-dot" : "list-checks")" style="width: 13px; height: 13px;"></i>
                                                            @(question.Type == QuestionType.SingleChoice ? Localizer["Single choice"] : Localizer["Multiple choice"])
                                                        </div>
                                                    </div>
                                                    @if (Model.CanEdit)
                                                    {
                                                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                                            <a asp-action="EditQuestion" asp-route-id="@question.Id" class="btn btn-sm btn-outline-primary">
                                                                <i class="align-middle me-sm-1" data-lucide="pencil"></i><span class="d-none d-sm-inline">@Localizer["Edit question"]</span>
                                                            </a>
                                                            @if (isDraft)
                                                            {
                                                                <div class="dropdown">
                                                                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-label="@Localizer["More question actions"]">
                                                                        <i class="align-middle" data-lucide="ellipsis-vertical"></i>
                                                                    </button>
                                                                    <ul class="dropdown-menu dropdown-menu-end shadow">
                                                                        <li>
                                                                            <form asp-action="MoveQuestionUp" method="post"><input type="hidden" name="id" value="@question.Id" /><button type="submit" class="dropdown-item" disabled="@isFirst"><i class="align-middle me-2" data-lucide="arrow-up"></i>@Localizer["Move up"]</button></form>
                                                                        </li>
                                                                        <li>
                                                                            <form asp-action="MoveQuestionDown" method="post"><input type="hidden" name="id" value="@question.Id" /><button type="submit" class="dropdown-item" disabled="@isLast"><i class="align-middle me-2" data-lucide="arrow-down"></i>@Localizer["Move down"]</button></form>
                                                                        </li>
                                                                        <li><hr class="dropdown-divider" /></li>
                                                                        <li>
                                                                            <form asp-action="DeleteQuestion" method="post" onsubmit="return confirmAction(event, '@Localizer["Are you sure you want to delete this question?"]')">
                                                                                <input type="hidden" name="id" value="@question.Id" />
                                                                                <button type="submit" class="dropdown-item text-danger"><i class="align-middle me-2" data-lucide="trash-2"></i>@Localizer["Delete"]</button>
                                                                            </form>
                                                                        </li>
                                                                    </ul>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>

                                                @if (options.Any())
                                                {
                                                    <div class="vstack gap-2">
                                                        @for (var optionIndex = 0; optionIndex < options.Count; optionIndex++)
                                                        {
                                                            var option = options[optionIndex];
                                                            var optionLabel = optionIndex < 26 ? ((char)('A' + optionIndex)).ToString() : (optionIndex + 1).ToString();
                                                            <div class="exam-option @(option.IsCorrect ? "is-correct" : string.Empty)">
                                                                <span class="exam-option-index">@optionLabel</span>
                                                                <span class="flex-grow-1">@option.Content</span>
                                                                @if (option.IsCorrect)
                                                                {
                                                                    <span class="small text-success fw-semibold d-inline-flex align-items-center gap-1"><i data-lucide="check" style="width: 14px; height: 14px;"></i>@Localizer["Correct"]</span>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="alert alert-warning alert-outline-coloured mb-0" role="alert">
                                                        <div class="alert-icon"><i data-lucide="triangle-alert"></i></div>
                                                        <div class="alert-message small">@Localizer["No options added yet."]</div>
                                                    </div>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(question.Explanation))
                                                {
                                                    <details class="mt-3">
                                                        <summary class="small fw-semibold text-muted" style="cursor: pointer;">@Localizer["Answer explanation"]</summary>
                                                        <div class="alert alert-info alert-outline-coloured mt-2 mb-0">
                                                            <div class="alert-icon"><i data-lucide="lightbulb"></i></div>
                                                            <div class="alert-message small">@question.Explanation</div>
                                                        </div>
                                                    </details>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="exam-empty">
                            <div class="exam-empty-icon"><i data-lucide="list-plus"></i></div>
                            <h3 class="h5">@Localizer["No questions yet"]</h3>
                            <p class="text-muted">@Localizer["Build the exam by adding the first choice question."]</p>
                            @if (Model.CanEdit && isDraft)
                            {
                                <a asp-action="AddQuestion" asp-route-id="@Model.Poll.Id" class="btn btn-primary">@Localizer["Add first question"]</a>
                            }
                        </div>
                    }
                </div>
            </section>
        </div>

        <aside class="col-xl-4">
            <section class="exam-card mb-4">
                <div class="card-header">
                    <h2 class="exam-section-title">
                        <span class="section-icon"><i data-lucide="gauge"></i></span>
                        @Localizer["Exam setup"]
                    </h2>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(Model.Poll.Description))
                    {
                        <p class="text-muted small lh-lg">@Model.Poll.Description</p>
                        <hr />
                    }
                    <div class="row g-2">
                        <div class="col-6"><div class="exam-stat"><div class="exam-stat-label">@Localizer["Questions"]</div><div class="exam-stat-value">@Model.Poll.QuestionsPerAttempt</div></div></div>
                        <div class="col-6"><div class="exam-stat"><div class="exam-stat-label">@Localizer["Duration"]</div><div class="exam-stat-value">@Model.Poll.DurationMinutes <small class="fw-normal">@Localizer["min"]</small></div></div></div>
                        <div class="col-6"><div class="exam-stat"><div class="exam-stat-label">@Localizer["Passing score"]</div><div class="exam-stat-value">@Model.Poll.PassingScore</div></div></div>
                        <div class="col-6"><div class="exam-stat"><div class="exam-stat-label">@Localizer["Maximum"]</div><div class="exam-stat-value">@(Model.Poll.QuestionsPerAttempt * Model.Poll.FullScore)</div></div></div>
                    </div>
                    <hr />
                    <div class="exam-meta flex-column align-items-start gap-2">
                        <span><i data-lucide="users"></i><strong>@Localizer["Access"]:</strong> @accessText</span>
                        <span><i data-lucide="user-round"></i><strong>@Localizer["Owner"]:</strong> @(Model.Poll.CreatedBy?.DisplayName ?? Localizer["System"].Value)</span>
                        <span><i data-lucide="eye"></i><strong>@Localizer["Results"]:</strong> @Model.Poll.Visibility</span>
                    </div>

                    <details class="border-top mt-3 pt-3">
                        <summary class="fw-semibold small" style="cursor: pointer;">@Localizer["Advanced scoring and randomization"]</summary>
                        <div class="mt-3 small">
                            <div class="d-flex justify-content-between py-1"><span class="text-muted">@Localizer["Full answer"]</span><strong>@Model.Poll.FullScore</strong></div>
                            <div class="d-flex justify-content-between py-1"><span class="text-muted">@Localizer["Correct subset"]</span><strong>@Model.Poll.PartialScore</strong></div>
                            <div class="d-flex justify-content-between py-1"><span class="text-muted">@Localizer["Wrong option selected"]</span><strong>@Model.Poll.OverSelectionScore</strong></div>
                            <hr class="my-2" />
                            <div class="d-flex justify-content-between py-1"><span class="text-muted">@Localizer["Shuffle questions"]</span><strong>@(Model.Poll.ShuffleQuestions ? Localizer["On"] : Localizer["Off"])</strong></div>
                            <div class="d-flex justify-content-between py-1"><span class="text-muted">@Localizer["Shuffle options"]</span><strong>@(Model.Poll.ShuffleOptions ? Localizer["On"] : Localizer["Off"])</strong></div>
                            <div class="d-flex justify-content-between py-1"><span class="text-muted">@Localizer["Repeated attempts"]</span><strong>@(Model.Poll.AllowRepeatedSubmissions ? Localizer["Allowed"] : Localizer["Not allowed"])</strong></div>
                        </div>
                    </details>
                </div>
            </section>

            @if (Model.CanManage && Model.Poll.AccessType is AccessType.RoleBased or AccessType.Assigned)
            {
                <section class="exam-card mb-4">
                    <div class="card-header">
                        <h2 class="exam-section-title"><span class="section-icon"><i data-lucide="users"></i></span>@Localizer["Participation"]</h2>
                    </div>
                    <div class="card-body">
                        <div class="row g-2 mb-3">
                            <div class="col-6"><div class="exam-stat"><div class="exam-stat-label">@Localizer["Eligible"]</div><div class="exam-stat-value">@Model.EligibleVotersCount</div></div></div>
                            <div class="col-6"><div class="exam-stat"><div class="exam-stat-label">@Localizer["Pending"]</div><div class="exam-stat-value text-warning">@Model.PendingVotersCount</div></div></div>
                        </div>
                        <div class="d-grid gap-2">
                            <a asp-action="Submissions" asp-route-id="@Model.Poll.Id" class="btn btn-outline-primary btn-sm"><i class="align-middle me-1" data-lucide="bar-chart-3"></i>@Localizer["Employee results"]</a>
                            <a asp-action="VoterStatus" asp-route-id="@Model.Poll.Id" class="btn btn-outline-secondary btn-sm @(Model.Poll.IsAnonymous ? "disabled" : string.Empty)"><i class="align-middle me-1" data-lucide="users-round"></i>@Localizer["Participant status"]</a>
                        </div>
                        <details class="border-top mt-3 pt-3">
                            <summary class="small fw-semibold" style="cursor: pointer;">@Localizer["More participation tools"]</summary>
                            <div class="d-grid gap-2 mt-3">
                                <a asp-action="ExportPendingUsers" asp-route-id="@Model.Poll.Id" class="btn btn-outline-secondary btn-sm @(Model.Poll.IsAnonymous ? "disabled" : string.Empty)"><i class="align-middle me-1" data-lucide="download"></i>@Localizer["Export pending employees"]</a>
                            </div>
                        </details>
                    </div>
                </section>
            }

            @if (Model.CanManageShares)
            {
                <section class="exam-card mb-4">
                    <div class="card-header">
                        <h2 class="exam-section-title"><span class="section-icon"><i data-lucide="settings-2"></i></span>@Localizer["Administration"]</h2>
                        <p class="exam-subtitle">@Localizer["Manage availability and the exam lifecycle."]</p>
                    </div>
                    <div class="card-body">
                        @if (isDraft)
                        {
                            <form asp-action="Publish" method="post">
                                <input type="hidden" name="id" value="@Model.Poll.Id" />
                                <button type="submit" class="exam-admin-action w-100 text-start border-0">
                                    <span class="exam-admin-action-icon text-success bg-success-subtle"><i data-lucide="send"></i></span>
                                    <span class="flex-grow-1"><strong>@Localizer["Publish exam"]</strong><small>@Localizer["Open this exam for assigned employees."]</small></span>
                                    <i class="exam-admin-chevron" data-lucide="chevron-right"></i>
                                </button>
                            </form>
                        }
                        @if (isActive)
                        {
                            <div class="d-grid gap-2">
                                <a asp-action="Extend" asp-route-id="@Model.Poll.Id" class="exam-admin-action">
                                    <span class="exam-admin-action-icon"><i data-lucide="calendar-plus"></i></span>
                                    <span class="flex-grow-1"><strong>@Localizer["Extend deadline"]</strong><small>@Localizer["Current deadline"]: <span data-utc-time="@Model.Poll.Deadline.ToHtmlDateTime()"></span></small></span>
                                    <i class="exam-admin-chevron" data-lucide="chevron-right"></i>
                                </a>
                                @if (Model.Poll.AccessType == AccessType.RoleBased)
                                {
                                    <form asp-action="SendReminder" method="post">
                                        <input type="hidden" name="id" value="@Model.Poll.Id" />
                                        <button type="submit" class="exam-admin-action w-100 text-start">
                                            <span class="exam-admin-action-icon"><i data-lucide="bell-ring"></i></span>
                                            <span class="flex-grow-1"><strong>@Localizer["Send reminder"]</strong><small>@Localizer["Notify employees who have not completed the exam."]</small></span>
                                            <i class="exam-admin-chevron" data-lucide="chevron-right"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                        @if (canReopen)
                        {
                            <a asp-action="Extend" asp-route-id="@Model.Poll.Id" class="exam-admin-action">
                                <span class="exam-admin-action-icon text-success bg-success-subtle"><i data-lucide="rotate-ccw"></i></span>
                                <span class="flex-grow-1"><strong>@Localizer["Reopen exam"]</strong><small>@Localizer["Choose a new deadline and allow employees to start new attempts."]</small></span>
                                <i class="exam-admin-chevron" data-lucide="chevron-right"></i>
                            </a>
                        }
                        <details class="exam-danger-zone mt-3">
                            <summary>
                                <span class="d-inline-flex align-items-center gap-2"><i data-lucide="shield-alert"></i><strong>@Localizer["Danger zone"]</strong></span>
                                <i class="exam-danger-chevron" data-lucide="chevron-down"></i>
                            </summary>
                            <div class="exam-danger-panel">
                                <p class="small text-muted mb-3">@Localizer["These actions stop access or remove the exam from normal views."]</p>
                                @if (isActive)
                                {
                                    <div class="exam-danger-action">
                                        <div><strong>@Localizer["Terminate exam"]</strong><small>@Localizer["Stop new attempts while keeping the exam and its results."]</small></div>
                                        <form asp-action="Terminate" method="post" onsubmit="return confirmAction(event, '@Localizer["Are you sure you want to terminate this poll?"]')"><input type="hidden" name="id" value="@Model.Poll.Id" /><button type="submit" class="btn btn-outline-danger btn-sm">@Localizer["Terminate"]</button></form>
                                    </div>
                                }
                                <div class="exam-danger-action">
                                    <div><strong>@Localizer["Delete exam"]</strong><small>@Localizer["Hide the exam from normal views. This is a soft delete."]</small></div>
                                    <form asp-action="Invalidate" method="post" onsubmit="return confirmAction(event, '@Localizer["Are you sure you want to delete this poll? This is a soft delete."]')"><input type="hidden" name="id" value="@Model.Poll.Id" /><button type="submit" class="btn btn-outline-danger btn-sm">@Localizer["Delete"]</button></form>
                                </div>
                            </div>
                        </details>
                    </div>
                </section>
            }

            @if (Model.CanManage && Model.Poll.OperationLogs?.Any() == true)
            {
                <details class="exam-card">
                    <summary class="card-header" style="cursor: pointer;"><span class="exam-section-title"><span class="section-icon"><i data-lucide="history"></i></span>@Localizer["Activity log"]</span></summary>
                    <div class="list-group list-group-flush border-top" style="max-height: 20rem; overflow-y: auto;">
                        @foreach (var log in Model.Poll.OperationLogs.OrderByDescending(x => x.Timestamp))
                        {
                            <div class="list-group-item px-4 py-3 small">
                                <div class="d-flex justify-content-between gap-3"><strong>@log.Action</strong><span class="text-muted"><span data-utc-time="@log.Timestamp.ToHtmlDateTime()"></span></span></div>
                                @if (!string.IsNullOrWhiteSpace(log.Details)) { <div class="text-muted mt-1">@log.Details</div> }
                            </div>
                        }
                    </div>
                </details>
            }
        </aside>
    </div>
</div>

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script src="~/node_modules/sweetalert2/dist/sweetalert2.all.min.js"></script>
    <script>
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(function () {
                if (typeof window.Swal !== 'undefined') {
                    window.Swal.fire({ title: '@Localizer["Copied!"]', text: '@Localizer["Link copied to clipboard!"]', icon: 'success', timer: 1800, showConfirmButton: false });
                }
            });
        }

        function confirmAction(event, message) {
            if (typeof window.Swal === 'undefined') {
                return window.confirm(message);
            }
            event.preventDefault();
            const form = event.currentTarget;
            window.Swal.fire({
                title: '@Localizer["Confirm Action"]',
                text: message,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: '@Localizer["Yes"]',
                cancelButtonText: '@Localizer["Cancel"]'
            }).then(result => { if (result.isConfirmed) form.submit(); });
            return false;
        }
    </script>
}
