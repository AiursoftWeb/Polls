<div id="participant-link-text" hidden>
    <span data-key="title">@Localizer["Participant link"]</span>
    <span data-key="manual">@Localizer["Automatic copying is unavailable. Copy this link manually."]</span>
    <span data-key="close">@Localizer["Close"]</span>
</div>
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="participant-link-toast" class="toast" role="status" aria-live="polite" aria-atomic="true">
        <div class="toast-body">
            <i class="align-middle me-2 text-success" data-lucide="check"></i>@Localizer["Link copied"]
        </div>
    </div>
</div>
