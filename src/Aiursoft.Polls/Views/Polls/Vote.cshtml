@using Aiursoft.Polls.Entities
@model Aiursoft.Polls.Models.PollsViewModels.VoteViewModel
@{
    Layout = null;
    var questions = Model.Attempt?.AttemptQuestions?.OrderBy(q => q.DisplayOrder).ToList() ?? [];
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.Poll?.Title</title>
    <link rel="stylesheet" href="/UIStack/dist/css/app.css" />
    <link rel="stylesheet" href="/styles/exam.css" />
    <style>
        body { background: #f4f6f9; }
        .exam-focus-header { background: rgba(255, 255, 255, 0.96); backdrop-filter: blur(14px); }
        .exam-focus-shell { max-width: 1180px; margin: 0 auto; padding: 1.5rem 1rem 5rem; }
        .exam-navigator { position: sticky; top: 7.5rem; }
        .exam-number-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .45rem; max-height: 22rem; overflow-y: auto; }
        .exam-number-link { display: flex; align-items: center; justify-content: center; aspect-ratio: 1; border: 1px solid var(--bs-border-color); border-radius: .5rem; color: var(--bs-secondary-color); background: var(--bs-body-bg); font-size: .75rem; font-weight: 700; text-decoration: none; }
        .exam-number-link:hover { border-color: var(--bs-primary); color: var(--bs-primary); }
        .exam-number-link.answered { border-color: rgba(var(--bs-success-rgb), .5); color: var(--bs-success); background: rgba(var(--bs-success-rgb), .09); }
        .question-card { scroll-margin-top: 8rem; }
        @@media (max-width: 991.98px) { .exam-focus-shell { padding-top: 1rem; } }
    </style>
</head>
<body class="exam-ui">
    <header class="exam-focus-header sticky-top border-bottom shadow-sm">
        <div class="container-fluid py-3" style="max-width: 1180px;">
            <div class="d-flex align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3 overflow-hidden">
                    <div class="exam-question-number d-none d-sm-inline-flex"><i data-lucide="shield-check"></i></div>
                    <div class="overflow-hidden">
                        <div class="text-muted small">@Localizer["On-call license assessment"]</div>
                        <div class="fw-bold text-truncate">@Model.Poll?.Title</div>
                    </div>
                </div>
                <div class="text-end flex-shrink-0">
                    <div class="text-muted small d-flex align-items-center justify-content-end gap-1">
                        <i data-lucide="clock-3" style="width: 14px; height: 14px;"></i> @Localizer["Time remaining"]
                    </div>
                    <div class="exam-timer text-danger" id="countdown">--:--</div>
                </div>
            </div>
            <div class="progress mt-2" style="height: 5px;">
                <div class="progress-bar" id="timeProgress" role="progressbar" style="width: 100%;"></div>
            </div>
        </div>
    </header>

    <main class="exam-focus-shell">
        <div class="alert alert-primary alert-outline-coloured mb-4" role="alert">
            <div class="alert-icon"><i data-lucide="info"></i></div>
            <div class="alert-message d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div>
                    <strong>@Localizer["Attempt"] #@Model.Attempt?.AttemptNumber</strong>
                    <span class="d-block small text-muted">@questions.Count @Localizer["questions"] · @Model.Poll?.DurationMinutes @Localizer["minutes"] · @Localizer["Answers are saved automatically."]</span>
                </div>
                <div class="small"><strong id="answeredCount">0</strong> / @questions.Count @Localizer["answered"]</div>
            </div>
        </div>

        <details class="exam-card mb-3 d-lg-none">
            <summary class="card-body fw-semibold">@Localizer["Question navigator"]</summary>
            <div class="card-body border-top pt-3">
                <div class="exam-number-grid">
                    @for (var i = 0; i < questions.Count; i++)
                    {
                        <a href="#question-@questions[i].Id" class="exam-number-link" data-nav-question="@questions[i].Id">@(i + 1)</a>
                    }
                </div>
            </div>
        </details>

        <form asp-action="Vote" method="post" id="examForm">
            <input type="hidden" asp-for="PollId" />
            <input type="hidden" asp-for="AttemptId" />

            <div class="row g-4">
                <aside class="col-lg-3 d-none d-lg-block">
                    <div class="exam-card exam-navigator">
                        <div class="card-header">
                            <h2 class="exam-section-title">
                                <span class="section-icon"><i data-lucide="layout-grid"></i></span>
                                @Localizer["Questions"]
                            </h2>
                            <p class="exam-subtitle">@Localizer["Answered questions are shown in green."]</p>
                        </div>
                        <div class="card-body">
                            <div class="exam-number-grid">
                                @for (var i = 0; i < questions.Count; i++)
                                {
                                    <a href="#question-@questions[i].Id" class="exam-number-link" data-nav-question="@questions[i].Id">@(i + 1)</a>
                                }
                            </div>
                            <div class="border-top mt-3 pt-3 small text-muted" id="saveState">
                                <i class="align-middle me-1" data-lucide="cloud-check"></i>
                                @Localizer["All changes saved"]
                            </div>
                        </div>
                    </div>
                </aside>

                <div class="col-lg-9">
                    @for (var i = 0; i < questions.Count; i++)
                    {
                        var question = questions[i];
                        var selected = Model.Attempt?.AttemptSelections?
                            .Where(s => s.AttemptQuestionId == question.Id)
                            .Select(s => s.AttemptOptionId)
                            .ToHashSet() ?? [];
                        var options = question.Options?.OrderBy(o => o.DisplayOrder).ToList() ?? [];

                        <section id="question-@question.Id" class="exam-question question-card mb-4" data-question-id="@question.Id">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-start gap-3 mb-4">
                                    <div class="exam-question-number">@(i + 1)</div>
                                    <div>
                                        <h2 class="h5 mb-2 lh-base">@question.Title</h2>
                                        <div class="text-muted small d-flex align-items-center gap-1">
                                            <i data-lucide="@(question.Type == QuestionType.SingleChoice ? "circle-dot" : "list-checks")" style="width: 14px; height: 14px;"></i>
                                            @(question.Type == QuestionType.SingleChoice ? Localizer["Select one option"] : Localizer["Select all applicable options"])
                                        </div>
                                    </div>
                                </div>

                                <input type="hidden" name="SelectedOptions[@question.Id]" class="selection-value" value="@string.Join(',', selected)" />
                                <div class="vstack gap-2">
                                    @for (var optionIndex = 0; optionIndex < options.Count; optionIndex++)
                                    {
                                        var option = options[optionIndex];
                                        var inputType = question.Type == QuestionType.SingleChoice ? "radio" : "checkbox";
                                        var optionLabel = optionIndex < 26 ? ((char)('A' + optionIndex)).ToString() : (optionIndex + 1).ToString();
                                        <label class="exam-option">
                                            <input type="@inputType"
                                                   class="form-check-input me-3 answer-input"
                                                   name="question_@question.Id"
                                                   value="@option.Id"
                                                   checked="@(selected.Contains(option.Id) ? "checked" : null)" />
                                            <span class="exam-option-index">@optionLabel</span>
                                            <span>@option.Content</span>
                                        </label>
                                    }
                                </div>
                            </div>
                        </section>
                    }

                    <div class="exam-action-bar">
                        <div class="exam-card">
                            <div class="card-body d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
                                <div>
                                    <strong>@Localizer["Ready to submit?"]</strong>
                                    <div class="text-muted small">@Localizer["You can still review and change answers before submitting."]</div>
                                </div>
                                <button type="submit" class="btn btn-primary btn-lg px-4" id="submitButton">
                                    @Localizer["Submit exam"] <i class="align-middle ms-1" data-lucide="send"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </main>

    <script src="/UIStack/dist/js/app.js"></script>
    <script>
        (() => {
            const form = document.getElementById('examForm');
            const expiresAt = new Date('@Model.Attempt?.ExpiresAt.ToString("O")').getTime();
            const startedAt = new Date('@Model.Attempt?.StartedAt.ToString("O")').getTime();
            const total = expiresAt - startedAt;
            const saveState = document.getElementById('saveState');
            let submitting = false;

            function updateAnsweredState() {
                let answered = 0;
                document.querySelectorAll('.question-card').forEach(card => {
                    const hasAnswer = card.querySelectorAll('.answer-input:checked').length > 0;
                    document.querySelectorAll(`[data-nav-question="${card.dataset.questionId}"]`).forEach(link => link.classList.toggle('answered', hasAnswer));
                    if (hasAnswer) answered++;
                });
                document.getElementById('answeredCount').textContent = answered;
            }

            function updateTimer() {
                const remaining = Math.max(0, expiresAt - Date.now());
                const seconds = Math.floor(remaining / 1000);
                const hours = Math.floor(seconds / 3600);
                const minutes = Math.floor((seconds % 3600) / 60);
                const secs = seconds % 60;
                document.getElementById('countdown').textContent =
                    (hours ? String(hours).padStart(2, '0') + ':' : '') +
                    String(minutes).padStart(2, '0') + ':' +
                    String(secs).padStart(2, '0');
                document.getElementById('timeProgress').style.width = Math.max(0, remaining / total * 100) + '%';
                if (remaining <= 0 && !submitting) {
                    submitting = true;
                    form.submit();
                }
            }

            updateTimer();
            updateAnsweredState();
            setInterval(updateTimer, 1000);

            document.querySelectorAll('.answer-input').forEach(input => input.addEventListener('change', async event => {
                const card = event.target.closest('.question-card');
                const selected = [...card.querySelectorAll('.answer-input:checked')].map(x => Number(x.value));
                card.querySelector('.selection-value').value = selected.join(',');
                updateAnsweredState();
                if (saveState) saveState.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>@Localizer["Saving…"]';
                try {
                    const response = await fetch('@Url.Action("SaveAttemptAnswer", "Polls")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': form.querySelector('input[name="__RequestVerificationToken"]').value
                        },
                        body: JSON.stringify({
                            attemptId: @Model.AttemptId,
                            attemptQuestionId: Number(card.dataset.questionId),
                            optionIds: selected
                        })
                    });
                    if (response.status === 409) {
                        submitting = true;
                        form.submit();
                        return;
                    }
                    if (saveState) saveState.innerHTML = response.ok
                        ? '<i class="align-middle me-1" data-lucide="cloud-check"></i>@Localizer["All changes saved"]'
                        : '<i class="align-middle me-1 text-warning" data-lucide="cloud-alert"></i>@Localizer["Save failed; final submission will retry."]';
                    if (window.lucide) window.lucide.createIcons();
                } catch {
                    if (saveState) saveState.textContent = '@Localizer["Offline; final submission will retry."]';
                }
            }));

            form.addEventListener('submit', () => {
                submitting = true;
                const button = document.getElementById('submitButton');
                button.disabled = true;
                button.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Submitting…"]';
            });
        })();
    </script>
</body>
</html>
