@model Aiursoft.Polls.Models.HomeViewModels.IndexViewModel

@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/styles/site.css" xmlns="http://www.w3.org/1999/html"/>
    <link rel="stylesheet" href="~/styles/marketing.css" xmlns="http://www.w3.org/1999/html"/>
}

<vc:marketing-navbar></vc:marketing-navbar>

<section class="landing-intro text-bg-dark pt-5 pt-lg-6 pb-5 pb-lg-7">
    <div class="landing-intro-content container h-100">
        <div class="row align-items-center h-100">
            <div class="col-lg-5 mx-auto">
                <span class="badge badge-subtle-primary p-1">@Localizer["Open Source"]</span>
                <span class="badge badge-subtle-primary p-1">@Localizer["Free"]</span>
                <span class="badge badge-subtle-primary p-1">@Localizer["MIT Licence"]</span>
                <h1 id="main-slogan" class="my-4 text-white" style="font-size: 3rem;">
                    @Localizer["Powerful Polling."] <span class='text-primary'>@Localizer["For Everyone."]</span>
                </h1>
                <p class="text-lg text-white-50">@Localizer["The definitive, open-source solution for creating polls and surveys. From team feedback to large-scale voting, Aiursoft Polls makes it easy."]</p>
                <div class="my-4">
                    <a asp-controller="Polls" asp-action="Create" class="btn btn-primary btn-lg btn-pill">
                        <i class="align-middle" data-lucide="rocket"></i> @Localizer["Create a poll"]
                    </a>
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-primary btn-lg btn-pill">
                        <i class="align-middle" data-lucide="grid"></i> @Localizer["Go to dashboard"]
                    </a>
                </div>
            </div>
            <div class="col-lg-7 d-none d-lg-flex mx-auto text-center">
                <div class="landing-intro-screenshot">
                    <img src="~/images/screenshot.png" alt="Aiursoft Polls screenshot" class="img-fluid" />
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-6">
    <div class="container">
        <div class="mb-5 text-center">
            <span class="text-uppercase text-primary text-sm fw-medium mb-1 d-block">@Localizer["Rich Features"]</span>
            <h2 class="h1">@Localizer["Everything you need for successful polling."]</h2>
        </div>

        <div class="row">
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="layout"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Multi-Question Polls"]</h4>
                        <p class="fs-lg">@Localizer["Create complex surveys with multiple questions in a single poll, supporting various response types."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="shield-check"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Granular Access Control"]</h4>
                        <p class="fs-lg">@Localizer["Set your polls to be public, restricted to registered users, or limited to specific organization roles."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="bar-chart-3"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Real-time Results"]</h4>
                        <p class="fs-lg">@Localizer["Watch votes come in live with beautiful, easy-to-read charts and data summaries."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="eye"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Result Visibility Control"]</h4>
                        <p class="fs-lg">@Localizer["Choose to hide results until the poll ends, keep them private to the owner, or show them to everyone."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="clipboard-list"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Audit Logging"]</h4>
                        <p class="fs-lg">@Localizer["Every modification to a poll is logged for full transparency and accountability."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="settings-2"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Flexible Management"]</h4>
                        <p class="fs-lg">@Localizer["Open or close polls at any time, manage questions and options, and export raw submission data."]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<section class="immersive-section position-relative w-100 overflow-hidden d-flex align-items-center">

    <div class="immersive-bg">
        <div class="bg-image-wrapper">
             <a asp-controller="Polls" asp-action="Create">
                 <img src="~/images/polls_running_in_docker.webp" alt="Polls running in Docker" class="img-fluid object-fit-cover w-100 h-100">
             </a>
        </div>
        <div class="bg-overlay"></div>
    </div>

    <div class="container position-relative z-2 py-5">
        <div class="row">
            <div class="col-lg-6 offset-lg-6 col-md-12">

                <div class="mb-5 text-start ps-lg-4">
                    <div class="d-inline-flex align-items-center px-3 py-1 mb-3 rounded-pill border border-white-10 bg-dark-glass-sm backdrop-blur">
                        <span class="text-info me-2"><i class="fas fa-server"></i></span>
                        <span class="text-gray-300 small fw-medium text-uppercase tracking-wider">@Localizer["Private & Secure"]</span>
                    </div>
                    <h2 class="display-4 fw-bold text-white mb-3">
                        <span class="text-primary">@Localizer["Your Data"]</span><br>
                        @Localizer["Under Your Control"]
                    </h2>
                    <p class="lead text-gray-400 fs-5">
                        @Localizer["Host it yourself. No third-party trackers, no data harvesting. Your polls stay in your network."]
                    </p>
                </div>

                <div class="row g-3 ps-lg-4">

                    @* Card 1: One Click Start *@
                    <div class="col-md-6">
                        <div class="card bg-dark-glass border-white-10 h-100 hover-lift">
                            <div class="card-body p-4">
                                <div class="icon-box-sm bg-success-subtle text-success rounded-3 me-3 mb-3">
                                    <i class="fas fa-play-circle fa-lg"></i>
                                </div>
                                <h5 class="fw-bold text-white fs-6">@Localizer["Easy Deployment"]</h5>
                                <p class="text-gray-400 mb-0 lh-sm"> @Localizer["Start with a single 'docker run' command."]</p>
                            </div>
                        </div>
                    </div>

                    @* Card 2: Privacy Focused *@
                    <div class="col-md-6">
                         <div class="card bg-dark-glass border-white-10 h-100 hover-lift">
                            <div class="card-body p-4">
                                <div class="icon-box-sm bg-info-subtle text-info rounded-3 me-3 mb-3">
                                    <i class="fas fa-user-shield fa-lg"></i>
                                </div>
                                <h5 class="fw-bold text-white fs-6">@Localizer["Privacy First"]</h5>
                                <p class="text-gray-400 mb-0 lh-sm"> @Localizer["GDPR compliant by design. You own the database."]</p>
                            </div>
                        </div>
                    </div>

                    @* Card 3: Zero Config *@
                    <div class="col-12">
                        <div class="card bg-dark-glass border-white-10 h-100 hover-lift">
                            <div class="card-body p-4 d-flex align-items-center">
                                <div class="icon-box-sm bg-white-10 text-white rounded-3 me-3">
                                    <i class="fas fa-database"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold text-white mb-1 fs-6"> @Localizer["Zero Configuration"]</h5>
                                    <p class="text-gray-400 mb-0">@Localizer["Built-in SQLite support for small teams, or scale to MySQL for enterprise use."]</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="card bg-dark-glass border-white-10 h-100 hover-lift text-center py-2">
                            <div class="card-body p-2">
                                <i class="fas fa-user-lock text-warning mb-2 fs-5"></i>
                                <div class="text-gray-300 fw-bold" style="font-size: 0.75rem">@Localizer["Built-in Auth"]</div>
                                <div class="text-gray-500">@Localizer["Full RBAC"]</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card bg-dark-glass border-white-10 h-100 hover-lift text-center py-2">
                            <div class="card-body p-2">
                                <i class="fas fa-chart-line text-primary mb-2 fs-5"></i>
                                <div class="text-gray-300 fw-bold" style="font-size: 0.75rem">@Localizer["Real-time"]</div>
                                <div class="text-gray-500">@Localizer["Analytics"]</div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>


<section class="py-6">
    <div class="container">
        <div class="mb-5 text-center">
            <span class="text-uppercase text-primary text-sm fw-medium mb-1 d-block">@Localizer["Advanced Question Types"]</span>
            <h2 class="h1">@Localizer["Gather the right data, every time."]</h2>
        </div>

        <div class="row">
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="check-circle"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Single Choice"]</h4>
                        <p class="fs-lg">@Localizer["Classic radio-button style questions where participants select exactly one option."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="check-square"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Multiple Choice"]</h4>
                        <p class="fs-lg">@Localizer["Allow participants to select one or more options that apply to them."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="type"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Text Response"]</h4>
                        <p class="fs-lg">@Localizer["Gather qualitative feedback with open-ended text questions for detailed answers."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="list-ordered"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Option Management"]</h4>
                        <p class="fs-lg">@Localizer["Easily add, remove, and reorder options for your choices at any time before voting starts."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="lock"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Submission Locking"]</h4>
                        <p class="fs-lg">@Localizer["Once a user submits their response, it's locked to ensure data integrity and prevent double voting."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="download"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Data Export"]</h4>
                        <p class="fs-lg">@Localizer["Download all submissions in standard formats for offline analysis in Excel or other tools."]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>



<section class="immersive-section position-relative w-100 overflow-hidden d-flex align-items-center border-top border-white-10">

    <div class="immersive-bg-right">
        <div class="bg-image-wrapper">
             <a asp-controller="Polls" asp-action="Index">
                <img src="~/images/docs-photo.webp" alt="Simple and Easy" class="img-fluid object-fit-cover w-100 h-100">
             </a>
        </div>
        <div class="bg-overlay"></div>
    </div>

    <div class="container position-relative z-2 py-5">
        <div class="row">
            <div class="col-lg-6 col-md-12">

                <div class="mb-5 text-start pe-lg-4">
                    <div class="d-inline-flex align-items-center px-3 py-1 mb-3 rounded-pill border border-white-10 bg-dark-glass-sm backdrop-blur">
                        <span class="text-warning me-2"><i class="fas fa-users"></i></span>
                        <span class="text-gray-300 small fw-medium text-uppercase tracking-wider">@Localizer["Organization Friendly"]</span>
                    </div>
                    <h2 class="display-4 fw-bold text-white mb-3">
                        <span class="text-primary">@Localizer["Identity Aware"]</span><br>
                        @Localizer["Role-Based Voting"]
                    </h2>
                    <p class="lead text-gray-400 fs-5">
                        @Localizer["Restict participation based on your organization's hierarchy and roles."]
                    </p>
                </div>

                <div class="row g-3 pe-lg-4">

                    @* Card 1: Role Restrictions *@
                    <div class="col-md-6">
                        <div class="card bg-dark-glass border-white-10 h-100 hover-lift">
                            <div class="card-body p-4">
                                <div class="icon-box-sm bg-primary-subtle text-primary rounded-3 me-3 mb-3">
                                    <i class="fas fa-user-tag fa-lg"></i>
                                </div>
                                <h5 class="fw-bold text-white fs-6">@Localizer["Role Restrictions"]</h5>
                                <p class="text-gray-400 mb-0 lh-sm"> @Localizer["Specify exactly which roles can participate in each poll."]</p>
                            </div>
                        </div>
                    </div>

                    @* Card 2: Enterprise SSO *@
                    <div class="col-md-6">
                         <div class="card bg-dark-glass border-white-10 h-100 hover-lift">
                            <div class="card-body p-4">
                                <div class="icon-box-sm bg-danger-subtle text-danger rounded-3 me-3 mb-3">
                                    <i class="fab fa-microsoft fa-lg"></i>
                                </div>
                                <h5 class="fw-bold text-white fs-6">@Localizer["Enterprise SSO"]</h5>
                                <p class="text-gray-400 mb-0 lh-sm"> @Localizer["Login via OpenID Connect including Azure AD and Okta."]</p>
                            </div>
                        </div>
                    </div>

                    @* Card 3: Role Discovery *@
                    <div class="col-12">
                        <div class="card bg-dark-glass border-white-10 h-100 hover-lift">
                            <div class="card-body p-4 d-flex align-items-center">
                                <div class="icon-box-sm bg-white-10 text-white rounded-3 me-3">
                                    <i class="fas fa-sync"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold text-white mb-1 fs-6"> @Localizer["Automatic Sync"]</h5>
                                    <p class="text-gray-400 mb-0">@Localizer["Roles are automatically synchronized from your identity provider."]</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="card bg-dark-glass border-white-10 h-100 hover-lift text-center py-2">
                            <div class="card-body p-2">
                                <i class="fas fa-id-card text-success mb-2 fs-5"></i>
                                <div class="text-gray-300 fw-bold" style="font-size: 0.75rem">@Localizer["Verified Identity"]</div>
                                <div class="text-gray-500">@Localizer["No Fake Votes"]</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card bg-dark-glass border-white-10 h-100 hover-lift text-center py-2">
                            <div class="card-body p-2">
                                <i class="fas fa-history text-info mb-2 fs-5"></i>
                                <div class="text-gray-300 fw-bold" style="font-size: 0.75rem">@Localizer["Audit Trail"]</div>
                                <div class="text-gray-500">@Localizer["Traceable"]</div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-6 border-top border-white-10">
    <div class="container">
        <div class="mb-5 text-center">
            <span class="text-uppercase text-primary text-sm fw-medium mb-1 d-block">@Localizer["Global Reach"]</span>
            <h2 class="h1">@Localizer["Poll anywhere, in any language."]</h2>
        </div>

        <div class="row">
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="languages"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Multilingual Interface"]</h4>
                        <p class="fs-lg">@Localizer["Supports 28 languages out of the box for a truly global audience."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="globe"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["UTC Core"]</h4>
                        <p class="fs-lg">@Localizer["Built with UTC core, ensuring that poll end times are consistent across all time zones."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="smartphone"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Mobile First"]</h4>
                        <p class="fs-lg">@Localizer["A fully responsive voting experience that works perfectly on any smartphone or tablet."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="moon"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Automatic Dark Mode"]</h4>
                        <p class="fs-lg">@Localizer["Smart UI that adapts to user's system dark/light preferences automatically."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="zap"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Lightweight & Fast"]</h4>
                        <p class="fs-lg">@Localizer["Optimized for speed to ensure low latency even on weak network connections."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3">
                    <div class="landing-feature">
                        <i data-lucide="navigation"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Role Discovery"]</h4>
                        <p class="fs-lg">@Localizer["Automatic navigation adjustments based on your management permissions."]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-6 bg-light">
    <div class="container">
        <div class="mb-5 text-center px-4">
            <span class="text-uppercase text-primary text-sm fw-medium mb-1 d-block">@Localizer["Polls vs. Surveys"]</span>
            <h2 class="h1">@Localizer["Why choose Aiursoft Polls?"]</h2>
            <div class="row justify-content-center">
                <div class="col-lg-10 col-xl-8">
                    <p class="text-muted fs-lg">
                        @Localizer["Generic survey tools are often overpriced and harvest your data. Aiursoft Polls provides a clean, fast, and private alternative that you can host yourself. We focus on simplicity and security, so you can focus on your questions."]
                    </p>
                </div>
            </div>
        </div>
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover table-bordered bg-white mb-0 text-center align-middle">
                <thead class="table-dark">
                    <tr>
                        <th class="text-start">@Localizer["Poll Features"]</th>
                        <th>Aiursoft Polls</th>
                        <th>Microsoft Forms</th>
                        <th>Google Forms</th>
                        <th>SurveyMonkey</th>
                        <th>Typeform</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-start fw-medium">@Localizer["Self Hosting"]</td>
                        <td><i class="fas fa-check-circle text-success" data-bs-toggle="tooltip" title="@Localizer["Full control"]"></i></td>
                        <td><i class="fas fa-times-circle text-danger" data-bs-toggle="tooltip" title="@Localizer["SaaS Only"]"></i></td>
                        <td><i class="fas fa-times-circle text-danger" data-bs-toggle="tooltip" title="@Localizer["SaaS Only"]"></i></td>
                        <td><i class="fas fa-times-circle text-danger" data-bs-toggle="tooltip" title="@Localizer["SaaS Only"]"></i></td>
                        <td><i class="fas fa-times-circle text-danger" data-bs-toggle="tooltip" title="@Localizer["SaaS Only"]"></i></td>
                    </tr>
                    <tr>
                        <td class="text-start fw-medium">@Localizer["Open Source"]</td>
                        <td><i class="fas fa-check-circle text-success" data-bs-toggle="tooltip" title="@Localizer["MIT License"]"></i></td>
                        <td><i class="fas fa-times-circle text-danger" data-bs-toggle="tooltip" title="@Localizer["Proprietary"]"></i></td>
                        <td><i class="fas fa-times-circle text-danger" data-bs-toggle="tooltip" title="@Localizer["Proprietary"]"></i></td>
                        <td><i class="fas fa-times-circle text-danger" data-bs-toggle="tooltip" title="@Localizer["Proprietary"]"></i></td>
                        <td><i class="fas fa-times-circle text-danger" data-bs-toggle="tooltip" title="@Localizer["Proprietary"]"></i></td>
                    </tr>
                    <tr>
                        <td class="text-start fw-medium">@Localizer["Active Directory Integration"]</td>
                        <td><i class="fas fa-check-circle text-success" data-bs-toggle="tooltip" title="@Localizer["Standard OIDC"]"></i></td>
                        <td><i class="fas fa-check-circle text-success" data-bs-toggle="tooltip" title="@Localizer["Native"]"></i></td>
