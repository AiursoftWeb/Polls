@using Aiursoft.Polls.Entities
@using Aiursoft.WebTools
@model Aiursoft.Polls.Models.PollsViewModels.IndexViewModel

@* ReSharper disable once Razor.SectionNotResolved *@
@section styles { <link rel="stylesheet" href="~/styles/exam.css" asp-append-version="true" /> }

<div class="exam-ui">
    <div class="exam-page-header">
        <div><div class="exam-kicker"><i data-lucide="building-2"></i>@Localizer["Administration"]</div><h1 class="h3">@Localizer["All exams"]</h1><p class="text-muted mb-0 mt-1">@Localizer["Review every assessment across the organization."]</p></div>
        <a asp-action="Create" class="btn btn-primary"><i class="align-middle me-1" data-lucide="plus"></i>@Localizer["Create exam"]</a>
    </div>
    <section class="exam-card">
        <div class="card-header"><h2 class="exam-section-title"><span class="section-icon"><i data-lucide="library-big"></i></span>@Localizer["Organization exams"]</h2><p class="exam-subtitle">@Model.ManagedPolls.Count @Localizer["exams"]</p></div>
        @if (Model.ManagedPolls.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th class="ps-4">@Localizer["Exam"]</th><th>@Localizer["Owner"]</th><th>@Localizer["Status"]</th><th>@Localizer["Audience"]</th><th>@Localizer["Deadline"]</th><th class="text-end pe-4">@Localizer["Action"]</th></tr></thead>
                    <tbody>
                    @foreach (var poll in Model.ManagedPolls)
                    {
                        var stateClass = poll.State switch { PollState.Published => "text-success", PollState.Completed => "text-info", PollState.Terminated => "text-warning", PollState.Void => "text-danger", _ => "text-secondary" };
                        var accessText = poll.AccessType switch { AccessType.Public => Localizer["Public"], AccessType.RegisteredOnly => Localizer["Registered employees"], AccessType.RoleBased => Localizer["Role based"], AccessType.Assigned => Localizer["Assigned"], _ => Localizer[poll.AccessType.ToString()] };
                        <tr>
                            <td class="ps-4"><div class="fw-semibold">@poll.Title</div><div class="text-muted small">@poll.QuestionsPerAttempt @Localizer["questions"] · @poll.DurationMinutes @Localizer["minutes"]</div></td>
                            <td>@(poll.CreatedBy?.DisplayName ?? Localizer["System"].Value)</td>
                            <td><span class="exam-state-label @stateClass"><span class="exam-state-dot"></span>@Localizer[poll.State.ToString()]</span></td>
                            <td><span class="d-inline-flex align-items-center gap-1"><i data-lucide="users" style="width: 14px; height: 14px;"></i>@accessText</span></td>
                            <td><span data-utc-time="@poll.Deadline.ToHtmlDateTime()"></span></td>
                            <td class="text-end pe-4"><a asp-action="Details" asp-route-id="@poll.Id" class="btn btn-outline-primary btn-sm">@Localizer["Open"]</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="exam-empty"><div class="exam-empty-icon"><i data-lucide="inbox"></i></div><h3 class="h5">@Localizer["No exams found"]</h3><p class="text-muted mb-0">@Localizer["Organization exams will appear here."]</p></div>
        }
    </section>
</div>
