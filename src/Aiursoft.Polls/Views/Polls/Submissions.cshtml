@using Aiursoft.Polls.Entities
@using Aiursoft.Polls.Models.PollsViewModels
@using Aiursoft.Polls.Services.FileStorage
@using Aiursoft.WebTools
@inject IViewLocalizer Localizer
@inject StorageService StorageService
@model SubmissionsViewModel
@{
    var finalized = Model.Submissions.Where(x => x.Status != AttemptStatus.InProgress).ToList();
    var passed = finalized.Count(x => x.Passed);
    var passRate = finalized.Count == 0 ? 0 : (int)Math.Round(passed * 100m / finalized.Count);
}

@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/styles/exam.css" asp-append-version="true" />
}

<div class="exam-ui">
    <div class="exam-page-header">
        <div>
            <a asp-action="Details" asp-route-id="@Model.Poll?.Id" class="exam-back-link">
                <i data-lucide="arrow-left"></i> @Localizer["Back to exam"]
            </a>
            <div class="exam-kicker"><i data-lucide="bar-chart-3"></i> @Localizer["Performance"]</div>
            <h1 class="h3">@Localizer["Employee results"]</h1>
            <p class="text-muted mb-0 mt-1">@Model.Poll?.Title</p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="exam-stat d-flex align-items-center">
                <div class="exam-stat-icon"><i data-lucide="users"></i></div>
                <div><div class="exam-stat-label">@Localizer["Employees"]</div><div class="exam-stat-value">@Model.EmployeeSummaries.Count</div></div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="exam-stat d-flex align-items-center">
                <div class="exam-stat-icon"><i data-lucide="files"></i></div>
                <div><div class="exam-stat-label">@Localizer["Attempts"]</div><div class="exam-stat-value">@finalized.Count</div></div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="exam-stat d-flex align-items-center">
                <div class="exam-stat-icon text-success" style="background: rgba(var(--bs-success-rgb), .1);"><i data-lucide="badge-check"></i></div>
                <div><div class="exam-stat-label">@Localizer["Passed"]</div><div class="exam-stat-value">@passed</div></div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="exam-stat d-flex align-items-center">
                <div class="exam-stat-icon text-info" style="background: rgba(var(--bs-info-rgb), .1);"><i data-lucide="percent"></i></div>
                <div><div class="exam-stat-label">@Localizer["Pass rate"]</div><div class="exam-stat-value">@passRate%</div></div>
            </div>
        </div>
    </div>

    <section class="exam-card mb-4">
        <div class="card-header">
            <h2 class="exam-section-title">
                <span class="section-icon"><i data-lucide="trophy"></i></span>
                @Localizer["Employee performance"]
            </h2>
            <p class="exam-subtitle">@Localizer["Highest score and score progression across every completed attempt."]</p>
        </div>
        @if (Model.EmployeeSummaries.Any())
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">@Localizer["Employee"]</th>
                            <th>@Localizer["Attempts"]</th>
                            <th>@Localizer["Highest score"]</th>
                            <th style="min-width: 240px;">@Localizer["Score history"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var employee in Model.EmployeeSummaries)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        @if (employee.User != null)
                                        {
                                            <img src="@StorageService.RelativePathToInternetUrl(employee.User.AvatarRelativePath)?w=72&square=true"
                                                 alt="@employee.User.DisplayName" class="rounded-circle" width="36" height="36" />
                                        }
                                        else
                                        {
                                            <div class="exam-question-number"><i data-lucide="user"></i></div>
                                        }
                                        <div>
                                            <div class="fw-semibold">@(employee.User?.DisplayName ?? Localizer["Anonymous"].Value)</div>
                                            @if (employee.User != null)
                                            {
                                                <div class="text-muted small">@employee.User.Email</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td><span class="fw-semibold">@employee.AttemptCount</span></td>
                                <td><span class="fs-5 fw-bold exam-score text-primary">@employee.HighestScore</span></td>
                                <td>
                                    <div class="exam-history" aria-label="@string.Join(" → ", employee.Attempts.OrderBy(x => x.AttemptNumber).Select(x => x.Score))">
                                        @foreach (var attempt in employee.Attempts.OrderBy(x => x.AttemptNumber))
                                        {
                                            <a asp-action="AttemptResult" asp-route-id="@attempt.Id"
                                               class="exam-history-step text-decoration-none @(attempt.Passed ? "text-success" : "text-body")"
                                               title="@Localizer["Attempt"] #@attempt.AttemptNumber">
                                                @attempt.Score
                                            </a>
                                            @if (attempt != employee.Attempts.OrderBy(x => x.AttemptNumber).Last())
                                            {
                                                <i class="text-muted" data-lucide="chevron-right" style="width: 13px; height: 13px;"></i>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="exam-empty">
                <div class="exam-empty-icon"><i data-lucide="inbox"></i></div>
                <h3 class="h5">@Localizer["No submissions yet"]</h3>
                <p class="text-muted mb-0">@Localizer["Employee scores will appear here after their first submission."]</p>
            </div>
        }
    </section>

    @if (Model.Submissions.Any())
    {
        <details class="exam-card">
            <summary class="card-header d-flex align-items-center justify-content-between" style="cursor: pointer;">
                <span>
                    <span class="exam-section-title d-inline-flex">
                        <span class="section-icon"><i data-lucide="list"></i></span>
                        @Localizer["Detailed attempt log"]
                    </span>
                    <span class="exam-subtitle d-none d-sm-block ms-5">@Localizer["Open the complete chronological submission ledger."]</span>
                </span>
                <i data-lucide="chevron-down"></i>
            </summary>
            <div class="table-responsive border-top">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">@Localizer["Employee"]</th>
                            <th>@Localizer["Submitted"]</th>
                            <th>@Localizer["Attempt"]</th>
                            <th>@Localizer["Score"]</th>
                            <th>@Localizer["Status"]</th>
                            <th class="text-end pe-4">@Localizer["Action"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var submission in Model.Submissions)
                        {
                            var stateClass = submission.Status == AttemptStatus.InProgress ? "text-warning" : submission.Passed ? "text-success" : "text-danger";
                            var stateText = submission.Status == AttemptStatus.InProgress ? Localizer["In progress"] : submission.Passed ? Localizer["Passed"] : Localizer["Failed"];
                            <tr>
                                <td class="ps-4 fw-semibold">@(submission.User?.DisplayName ?? Localizer["Anonymous"].Value)</td>
                                <td><span data-utc-time="@submission.SubmitTime.ToHtmlDateTime()"></span></td>
                                <td>#@submission.AttemptNumber</td>
                                <td class="fw-bold exam-score">@submission.Score / @submission.MaxScore</td>
                                <td><span class="exam-state-label @stateClass"><span class="exam-state-dot"></span>@stateText</span></td>
                                <td class="text-end pe-4">
                                    <a asp-action="AttemptResult" asp-route-id="@submission.Id" class="btn btn-outline-primary btn-sm">
                                        <i class="align-middle me-1" data-lucide="eye"></i> @Localizer["View"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    }
</div>
