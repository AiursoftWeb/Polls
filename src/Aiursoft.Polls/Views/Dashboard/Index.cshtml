@using Aiursoft.WebTools
@model Aiursoft.Polls.Models.DashboardViewModels.IndexViewModel

<div class="row mb-2 mb-xl-3">
    <div class="col-auto d-none d-sm-block">
        <h3>@Localizer["Polls Overview"]</h3>
    </div>

    <div class="col-auto ms-auto mt-n1">
        <a asp-controller="Polls" asp-action="Create" class="btn btn-primary">
            <i class="align-middle" data-lucide="plus"></i> @Localizer["Create a new poll"]
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-header bg-transparent">
                <h5 class="card-title mb-0"><i class="align-middle me-2 text-success" data-lucide="check-square"></i> @Localizer["To-Do Polls"]</h5>
            </div>
            <div class="list-group list-group-flush">
                @if (Model.ToDoPolls != null && Model.ToDoPolls.Any())
                {
                    @foreach (var poll in Model.ToDoPolls)
                    {
                        <a asp-controller="Polls" asp-action="Vote" asp-route-id="@poll.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3">
                            <div>
                                <div class="fw-bold">@poll.Title</div>
                                <div class="text-muted small">@Localizer["Deadline:"] <span data-utc-time="@poll.Deadline.ToHtmlDateTime()"></span></div>
                            </div>
                            <span class="badge bg-success rounded-pill">@Localizer["Vote"]</span>
                        </a>
                    }
                }
                else
                {
                    <div class="list-group-item text-muted p-4 text-center">
                        <i class="mb-2 d-block text-muted opacity-50" data-lucide="smile" style="width: 40px; height: 40px; margin: 0 auto;"></i>
                        @Localizer["No to-do polls right now."]
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-header bg-transparent">
                <h5 class="card-title mb-0"><i class="align-middle me-2 text-primary" data-lucide="clock"></i> @Localizer["My Voting History"]</h5>
            </div>
            <div class="list-group list-group-flush">
                @if (Model.HistoryPolls != null && Model.HistoryPolls.Any())
                {
                    @foreach (var poll in Model.HistoryPolls)
                    {
                        <a asp-controller="Polls" asp-action="Results" asp-route-id="@poll.Id" class="list-group-item list-group-item-action p-3">
                            <div class="fw-bold text-dark">@poll.Title</div>
                            <small class="text-muted">@Localizer["Completed"]</small>
                        </a>
                    }
                }
                else
                {
                    <div class="list-group-item text-muted p-4 text-center">
                         <i class="mb-2 d-block text-muted opacity-50" data-lucide="info" style="width: 40px; height: 40px; margin: 0 auto;"></i>
                        @Localizer["You haven't participated in any polls yet."]
                    </div>
                }
            </div>
        </div>
    </div>
</div>
