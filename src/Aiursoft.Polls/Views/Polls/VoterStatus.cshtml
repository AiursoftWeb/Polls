@using Aiursoft.Polls.Models.PollsViewModels
@using Aiursoft.Polls.Services.FileStorage
@using Aiursoft.WebTools
@inject IViewLocalizer Localizer
@inject StorageService StorageService
@model VoterStatusViewModel
@{
    var completedCount = Model.Users.Count(x => x.HasVoted);
    var pendingCount = Model.Users.Count - completedCount;
}

@* ReSharper disable once Razor.SectionNotResolved *@
@section styles { <link rel="stylesheet" href="~/styles/exam.css" asp-append-version="true" /> }

<div class="exam-ui">
    <div class="exam-page-header">
        <div><a asp-action="Details" asp-route-id="@Model.Poll?.Id" class="exam-back-link"><i data-lucide="arrow-left"></i>@Localizer["Back to exam"]</a><div class="exam-kicker"><i data-lucide="users-round"></i>@Localizer["Participation"]</div><h1 class="h3">@Localizer["Participant status"]</h1><p class="text-muted mb-0 mt-1">@Model.Poll?.Title</p></div>
    </div>

    @if (Model.Poll?.IsAnonymous == true)
    {
        <div class="alert alert-warning alert-outline-coloured mb-4"><div class="alert-icon"><i data-lucide="shield-alert"></i></div><div class="alert-message"><strong>@Localizer["Anonymous assessment"]</strong><span class="d-block small">@Localizer["Identity is not recorded, so participant completion cannot be tracked accurately."]</span></div></div>
    }

    <div class="row g-3 mb-4">
        <div class="col-4"><div class="exam-stat d-flex align-items-center"><div class="exam-stat-icon"><i data-lucide="users"></i></div><div><div class="exam-stat-label">@Localizer["Eligible"]</div><div class="exam-stat-value">@Model.Users.Count</div></div></div></div>
        <div class="col-4"><div class="exam-stat d-flex align-items-center"><div class="exam-stat-icon text-success" style="background: rgba(var(--bs-success-rgb), .1);"><i data-lucide="circle-check"></i></div><div><div class="exam-stat-label">@Localizer["Completed"]</div><div class="exam-stat-value">@completedCount</div></div></div></div>
        <div class="col-4"><div class="exam-stat d-flex align-items-center"><div class="exam-stat-icon text-warning" style="background: rgba(var(--bs-warning-rgb), .12);"><i data-lucide="clock-3"></i></div><div><div class="exam-stat-label">@Localizer["Pending"]</div><div class="exam-stat-value">@pendingCount</div></div></div></div>
    </div>

    <section class="exam-card">
        <div class="card-header"><h2 class="exam-section-title"><span class="section-icon"><i data-lucide="contact-round"></i></span>@Localizer["Employees"]</h2></div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th class="ps-4">@Localizer["Employee"]</th><th>@Localizer["Email"]</th><th>@Localizer["Status"]</th><th class="pe-4">@Localizer["Latest submission"]</th></tr></thead>
                <tbody>
                @foreach (var userStatus in Model.Users.OrderBy(u => u.HasVoted).ThenBy(u => u.User?.DisplayName))
                {
                    <tr>
                        <td class="ps-4"><div class="d-flex align-items-center gap-2"><img src="@StorageService.RelativePathToInternetUrl(userStatus.User?.AvatarRelativePath ?? Aiursoft.Polls.Entities.User.DefaultAvatarPath)?w=72&square=true" alt="@userStatus.User?.DisplayName" class="rounded-circle" width="36" height="36" /><span class="fw-semibold">@userStatus.User?.DisplayName</span></div></td>
                        <td class="text-muted">@userStatus.User?.Email</td>
                        <td><span class="exam-state-label @(userStatus.HasVoted ? "text-success" : "text-warning")"><span class="exam-state-dot"></span>@(userStatus.HasVoted ? Localizer["Completed"] : Localizer["Pending"])</span></td>
                        <td class="pe-4">@if (userStatus.VoteTime.HasValue) { <span data-utc-time="@userStatus.VoteTime.Value.ToHtmlDateTime()"></span> } else { <span class="text-muted">—</span> }</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>
