@using Aiursoft.Polls.Entities
@model Aiursoft.Polls.Models.PollsViewModels.AddQuestionViewModel

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Details" asp-route-id="@Model.PollId" class="text-decoration-none text-muted small mb-2 d-inline-block">
            ← @Localizer["Back to Poll"]
        </a>
        <h4 class="mb-0">➕ @Localizer["Add Question"]</h4>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="AddQuestion" method="post">
            <input type="hidden" asp-for="PollId" />
            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-semibold small"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Type" class="form-label fw-semibold small"></label>
                    <select asp-for="Type" asp-items="Html.GetEnumSelectList<QuestionType>()" class="form-select" id="questionTypeSelect"></select>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="form-check mt-4">
                        <input class="form-check-input" asp-for="IsRequired" />
                        <label class="form-check-label" asp-for="IsRequired">❗ @Localizer["Required"]</label>
                    </div>
                </div>
            </div>

            <div id="optionsSection">
                <h6>📝 @Localizer["Options"]</h6>
                <div id="optionsList">
                    <div class="input-group mb-2 option-row">
                        <input type="text" class="form-control" name="Options[0].Content" placeholder="@Localizer["Option text"]" />
                        <div class="input-group-text">
                            <input class="form-check-input" type="checkbox" name="Options[0].AllowCustomText" value="true" title="@Localizer["Allow custom text"]" />
                            <label class="ms-1 small">@Localizer["Other"]</label>
                        </div>
                        <button type="button" class="btn btn-outline-danger remove-option-btn">✕</button>
                    </div>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="addOptionBtn">
                    ＋ @Localizer["Add Option"]
                </button>
                <p class="text-muted small mt-2">💡 @Localizer["Tip: Checking 'Other' allows the voter to submit additional text information."]</p>
            </div>

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">💾 @Localizer["Add Question"]</button>
                <a asp-action="Details" asp-route-id="@Model.PollId" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
            </div>
        </form>
    </div>
</div>


@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var optionIndex = 1;
            var optionsList = document.getElementById("optionsList");
            var addBtn = document.getElementById("addOptionBtn");

            addBtn.addEventListener("click", function () {
                var row = document.createElement("div");
                row.className = "input-group mb-2 option-row";
                row.innerHTML = '<input type="text" class="form-control" name="Options[' + optionIndex + '].Content" placeholder="Option text" />'
                    + '<div class="input-group-text"><input class="form-check-input" type="checkbox" name="Options[' + optionIndex + '].AllowCustomText" value="true" /><label class="ms-1 small">Other</label></div>'
                    + '<button type="button" class="btn btn-outline-danger remove-option-btn">✕</button>';
                optionsList.appendChild(row);
                optionIndex++;
            });

            optionsList.addEventListener("click", function (e) {
                var btn = e.target.closest(".remove-option-btn");
                if (btn) {
                    btn.closest(".option-row").remove();
                }
            });
        });
    </script>
}
