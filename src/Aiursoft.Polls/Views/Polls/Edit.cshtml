@using Aiursoft.Polls.Entities
@model Aiursoft.Polls.Models.PollsViewModels.EditViewModel

<div class="row mb-2 mb-xl-3">
    <div class="col-auto d-none d-sm-block">
        <h3>@Localizer["Edit Poll"]</h3>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="AccessType" class="form-label"></label>
                    <select asp-for="AccessType" asp-items="Html.GetEnumSelectList<AccessType>()" class="form-select" id="accessTypeSelect"></select>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Visibility" class="form-label"></label>
                    <select asp-for="Visibility" asp-items="Html.GetEnumSelectList<ResultVisibility>()" class="form-select"></select>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Deadline" class="form-label"></label>
                    <input asp-for="Deadline" type="datetime-local" step="1" class="form-control" />
                    <span asp-validation-for="Deadline" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3">
                <div class="form-check">
                    <input class="form-check-input" asp-for="IsAnonymous" />
                    <label class="form-check-label" asp-for="IsAnonymous">@Localizer["Anonymous Poll (Database will not record user information)"]</label>
                    <i class="bi bi-question-circle text-secondary" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true"
                       title="@Localizer["<b>Cost of Anonymity:</b><br/>1. <b>Privacy:</b> No UserID, IP, or Fingerprint is stored.<br/>2. <b>Tracking:</b> You cannot see who has voted or not.<br/>3. <b>Dashboard:</b> This poll will not show in users' To-Do list.<br/>4. <b>Security:</b> Cannot strictly prevent duplicate votes from the same device/person."]"></i>
                </div>
            </div>
            <div class="mb-3" id="roleSection" style="display: none;">
                <label class="form-label">@Localizer["Allowed Roles"]</label>
                @foreach (var role in Model.AllRoles)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="SelectedRoles" value="@role.Id" id="role_@role.Id"
                               checked="@(Model.SelectedRoles.Contains(role.Id) ? "checked" : null)" />
                        <label class="form-check-label" for="role_@role.Id">@role.Name</label>
                    </div>
                }
            </div>
            <button type="submit" class="btn btn-primary">@Localizer["Save"]</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light">@Localizer["Cancel"]</a>
        </form>
    </div>
</div>

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            const select = document.getElementById("accessTypeSelect");
            const roleSection = document.getElementById("roleSection");
            function toggleRoles() {
                roleSection.style.display = select.value === "@((int)AccessType.RoleBased)" ? "block" : "none";
            }
            select.addEventListener("change", toggleRoles);
            toggleRoles();
        });
    </script>
}
