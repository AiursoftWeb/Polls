@using Aiursoft.Polls.Entities
@model Aiursoft.Polls.Models.PollsViewModels.VoteViewModel

@{
    var questions = Model.Poll?.Questions?.OrderBy(x => x.Order).ToList() ?? [];
    var totalSteps = questions.Count;
}

<style>
    :root {
        --duo-green: #58cc02;
        --duo-green-dark: #46a302;
        --duo-green-light: #61e002;
        --duo-blue: #1899d6;
        --duo-blue-light: #84d8ff;
        --duo-blue-bg: #ddf4ff;
        --duo-gray: #afafaf;
        --duo-gray-light: #e5e5e5;
        --duo-text: #3c3c3c;
        --duo-text-secondary: #777;
    }

    .voting-container {
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
        min-height: calc(100vh - 120px);
        display: flex;
        flex-direction: column;
    }

    /* Progress bar */
    .progress-bar-container {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 40px;
    }

    .progress-track {
        flex-grow: 1;
        height: 16px;
        background-color: var(--duo-gray-light);
        border-radius: 8px;
        overflow: hidden;
        position: relative;
    }

    .progress-fill {
        height: 100%;
        background-color: var(--duo-green);
        width: 0%;
        transition: width 0.4s cubic-bezier(0.65, 0, 0.35, 1);
        border-radius: 8px;
    }

    .progress-fill::after {
        content: '';
        position: absolute;
        top: 3px;
        left: 5px;
        right: 5px;
        height: 4px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 2px;
    }

    .close-btn {
        background: none;
        border: none;
        font-size: 24px;
        color: var(--duo-gray);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 5px;
        transition: color 0.2s;
    }

    .close-btn:hover {
        color: var(--duo-text);
    }

    /* Question cards */
    .question-step {
        display: none;
        animation: slideIn 0.4s ease-out;
    }

    .question-step.active {
        display: block;
    }

    @@keyframes slideIn {
        from { opacity: 0; transform: translateX(20px); }
        to { opacity: 1; transform: translateX(0); }
    }

    .question-title {
        font-size: 1.75rem;
        font-weight: 800;
        margin-bottom: 10px;
        color: var(--duo-text);
    }

    .question-subtitle {
        font-size: 1.1rem;
        color: var(--duo-text-secondary);
        margin-bottom: 30px;
    }

    /* Option cards */
    .options-grid {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 30px;
    }

    .option-card {
        border: 2px solid var(--duo-gray-light);
        border-bottom: 4px solid var(--duo-gray-light);
        border-radius: 16px;
        padding: 16px 24px;
        cursor: pointer;
        transition: all 0.1s;
        display: flex;
        align-items: center;
        gap: 15px;
        font-size: 1.15rem;
        font-weight: 700;
        color: #4b4b4b;
        user-select: none;
        background-color: white;
    }

    .option-card:hover {
        background-color: #f7f7f7;
        border-color: #d0d0d0;
    }

    .option-card:active {
        border-bottom-width: 2px;
        transform: translateY(2px);
    }

    .option-card.selected {
        border-color: var(--duo-blue-light);
        border-bottom-color: var(--duo-blue-light);
        background-color: var(--duo-blue-bg);
        color: var(--duo-blue);
    }

    /* Custom text input */
    .custom-text-container {
        display: none;
        margin-top: -8px;
        margin-bottom: 12px;
        padding: 0 10px;
    }

    .custom-text-input {
        width: 100%;
        padding: 12px 20px;
        border: 2px solid var(--duo-gray-light);
        border-radius: 16px;
        font-size: 1rem;
        outline: none;
        background-color: #fdfdfd;
        transition: border-color 0.2s;
    }

    .custom-text-input:focus {
        border-color: var(--duo-blue-light);
    }

    /* Footer / Action Bar */
    .voting-footer {
        margin-top: auto;
        padding: 25px 0;
        border-top: 2px solid var(--duo-gray-light);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .btn-duo {
        padding: 14px 32px;
        border-radius: 16px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        border: none;
        cursor: pointer;
        transition: all 0.1s;
        font-size: 0.95rem;
    }

    .btn-duo-secondary {
        background-color: white;
        color: var(--duo-gray);
        border: 2px solid var(--duo-gray-light);
        border-bottom: 4px solid var(--duo-gray-light);
    }

    .btn-duo-secondary:hover:not(:disabled) {
        background-color: #f7f7f7;
    }

    .btn-duo-secondary:active:not(:disabled) {
        border-bottom-width: 2px;
        transform: translateY(2px);
    }

    .btn-duo-primary {
        background-color: var(--duo-green);
        color: white;
        border-bottom: 4px solid var(--duo-green-dark);
        flex-grow: 1;
        max-width: 240px;
    }

    .btn-duo-primary:hover:not(:disabled) {
        background-color: var(--duo-green-light);
    }

    .btn-duo-primary:active:not(:disabled) {
        border-bottom-width: 0;
        transform: translateY(4px);
    }

    .btn-duo-primary:disabled {
        background-color: var(--duo-gray-light);
        border-bottom-color: #ccc;
        color: var(--duo-gray);
        cursor: not-allowed;
    }

    .hidden {
        display: none !important;
    }

    @@media (max-width: 576px) {
        .voting-container {
            padding: 15px;
        }
        .question-title {
            font-size: 1.5rem;
        }
        .btn-duo {
            padding: 12px 20px;
        }
    }
</style>

<div class="voting-container">
    <div class="progress-bar-container">
        <a asp-action="Index" class="close-btn" title="@Localizer["Cancel"]">
            <i class="align-middle" data-lucide="x"></i>
        </a>
        <div class="progress-track">
            <div id="progressFill" class="progress-fill"></div>
        </div>
    </div>

    <form asp-action="Vote" method="post" id="voteForm">
        <input type="hidden" asp-for="PollId" />
        <input type="hidden" asp-for="BrowserFingerprint" id="browserFingerprint" />

        @for (int i = 0; i < questions.Count; i++)
        {
            var q = questions[i];
            <div class="question-step @(i == 0 ? "active" : "")" data-step="@i" data-required="@q.IsRequired.ToString().ToLower()" data-type="@q.Type">
                <h2 class="question-title">@q.Title</h2>
                <p class="question-subtitle">
                    @switch (q.Type)
                    {
                        case QuestionType.SingleChoice: @Localizer["Select the best option"] break;
                        case QuestionType.MultipleChoice: @Localizer["Select all that apply"] break;
                    }
                    @if (q.IsRequired) { <span class="text-danger">*</span> }
                </p>
                
                <div class="options-grid">
                    @if (q.Options != null)
                    {
                        foreach (var opt in q.Options.OrderBy(o => o.DisplayOrder))
                        {
                            <div class="option-card" data-opt-id="@opt.Id" data-question-id="@q.Id" data-has-custom="@opt.AllowCustomText.ToString().ToLower()">
                                <span>@opt.Content</span>
                            </div>
                            
                            if (opt.AllowCustomText)
                            {
                                <div class="custom-text-container" id="custom_text_container_@opt.Id">
                                    <input type="text" 
                                           class="custom-text-input" 
                                           name="CustomTexts[@q.Id]" 
                                           placeholder="@Localizer["Please specify..."]" 
                                           data-opt-id="@opt.Id" />
                                </div>
                            }
                        }
                    }
                </div>
                
                @if (q.Type == QuestionType.MultipleChoice)
                {
                    <input type="hidden" name="SelectedOptions[@q.Id]" id="multiInput_@q.Id" value="" />
                }
                else
                {
                    <input type="hidden" name="SelectedOptions[@q.Id]" id="singleInput_@q.Id" value="" />
                }
            </div>
        }
    </form>

    <div class="voting-footer">
        <button id="prevBtn" class="btn-duo btn-duo-secondary hidden">@Localizer["Back"]</button>
        <div style="flex-grow: 1"></div>
        <button id="nextBtn" class="btn-duo btn-duo-primary" disabled>@Localizer["Continue"]</button>
    </div>
</div>

@section scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Browser fingerprint
            var fp = navigator.userAgent + "|" + screen.width + "x" + screen.height + "|" + new Date().getTimezoneOffset();
            document.getElementById("browserFingerprint").value = btoa(fp).substring(0, 200);

            const totalSteps = @totalSteps;
            let currentStep = 0;
            const steps = document.querySelectorAll('.question-step');
            const progressFill = document.getElementById('progressFill');
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');
            const voteForm = document.getElementById('voteForm');

            function updateUI() {
                // Update Progress
                const progress = ((currentStep) / totalSteps) * 100;
                progressFill.style.width = progress + '%';

                // Show/Hide steps
                steps.forEach((step, idx) => {
                    step.classList.toggle('active', idx === currentStep);
                });

                // Footer Buttons
                prevBtn.classList.toggle('hidden', currentStep === 0);
                
                if (currentStep === totalSteps - 1) {
                    nextBtn.innerText = "@Localizer["Finish"]";
                } else {
                    nextBtn.innerText = "@Localizer["Continue"]";
                }

                validateCurrentStep();
            }

            function validateCurrentStep() {
                const step = steps[currentStep];
                const isRequired = step.dataset.required === 'true';
                
                let isValid = true;
                if (isRequired) {
                    const selected = step.querySelectorAll('.option-card.selected');
                    if (selected.length === 0) {
                        isValid = false;
                    } else {
                        // Check custom text if needed
                        selected.forEach(card => {
                            if (card.dataset.hasCustom === 'true') {
                                const optId = card.dataset.optId;
                                const input = step.querySelector(`input[data-opt-id="${optId}"]`);
                                if (input && !input.value.trim()) {
                                    isValid = false;
                                }
                            }
                        });
                    }
                }
                
                nextBtn.disabled = !isValid;
            }

            // Handle Option Selection
            document.querySelectorAll('.option-card').forEach(card => {
                card.addEventListener('click', function() {
                    const step = this.closest('.question-step');
                    const type = step.dataset.type;
                    const questionId = this.dataset.questionId;
                    const optId = this.dataset.optId;
                    const hasCustom = this.dataset.hasCustom === 'true';

                    if (type === 'SingleChoice') {
                        step.querySelectorAll('.option-card').forEach(c => {
                            c.classList.remove('selected');
                            // Hide other custom texts
                            const otherOptId = c.dataset.optId;
                            const otherCustom = document.getElementById('custom_text_container_' + otherOptId);
                            if (otherCustom) otherCustom.style.display = 'none';
                        });
                        this.classList.add('selected');
                        document.getElementById('singleInput_' + questionId).value = optId;
                        
                        if (hasCustom) {
                            document.getElementById('custom_text_container_' + optId).style.display = 'block';
                        }
                    } else {
                        // Multiple Choice
                        this.classList.toggle('selected');
                        const selectedOpts = Array.from(step.querySelectorAll('.option-card.selected')).map(c => c.dataset.optId);
                        document.getElementById('multiInput_' + questionId).value = selectedOpts.join(',');
                        
                        if (hasCustom) {
                            const customContainer = document.getElementById('custom_text_container_' + optId);
                            customContainer.style.display = this.classList.contains('selected') ? 'block' : 'none';
                        }
                    }

                    validateCurrentStep();
                });
            });

            // Handle Custom Text Input
            document.querySelectorAll('.custom-text-input').forEach(input => {
                input.addEventListener('input', validateCurrentStep);
                input.addEventListener('click', e => e.stopPropagation());
            });

            nextBtn.addEventListener('click', function() {
                if (currentStep < totalSteps - 1) {
                    currentStep++;
                    updateUI();
                } else {
                    // Final Submit
                    nextBtn.disabled = true;
                    nextBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
                    progressFill.style.width = '100%';
                    setTimeout(() => {
                        voteForm.submit();
                    }, 500);
                }
            });

            prevBtn.addEventListener('click', function() {
                if (currentStep > 0) {
                    currentStep--;
                    updateUI();
                }
            });

            // Initial UI state
            updateUI();
        });
    </script>
}
